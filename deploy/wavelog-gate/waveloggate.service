[Unit]
Description=WaveLogGate (UDP QSO → Wavelog logbook)
Documentation=https://github.com/wavelog/WaveLogGate
# NÃO depender de wavelog.service/rigctld: o Wavelog leva minutos para subir no Pi 3 e
# segurava o WLG parado no boot. O gate só fala HTTP/UDP local e reconecta sozinho.
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=hamcockpit
Group=hamcockpit
WorkingDirectory=/opt/wavelog-gate
EnvironmentFile=-/opt/wavelog-gate/wavelog-gate.env
ExecStart=/usr/bin/node /opt/wavelog-gate/wavelog-gate.mjs
Restart=always
RestartSec=5
# UDP 2333 (QSO), HTTP 54321 (QSY + /status)

[Install]
WantedBy=ham-cockpit.target
WantedBy=multi-user.target
