[Unit]
Description=Hamlib rigctld IC-705 (porta/baud via ser2net device=radio)
After=ser2net.service
Wants=ser2net.service
StartLimitIntervalSec=300
StartLimitBurst=20
# Wrapper lê /opt/ser2net/services.json (device=radio).
# Clientes (WSJT-X, WaveLogGate, console): modelo 2 em 127.0.0.1:4532.

[Service]
Type=simple
ExecStart=/opt/ham-cockpit/bin/rigctld-ic705
Restart=on-failure
RestartSec=5

[Install]
WantedBy=ham-cockpit.target
