[Unit]
Description=Hamlib rigctld do rádio serial (modelo em radios.json, porta device=radio)
After=ser2net.service
Wants=ser2net.service
StartLimitIntervalSec=300
StartLimitBurst=20
# Wrapper lê device=radio e o hamlibModel do rádio. Sem isso, sai 0.
# Não usa a porta da SPE. Clientes: Hamlib NET em 127.0.0.1:4532.

[Service]
Type=simple
ExecStart=/opt/ham-cockpit/bin/rigctld-ic705
Restart=on-failure
RestartSec=5

[Install]
WantedBy=ham-cockpit.target
