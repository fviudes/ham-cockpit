#!/bin/bash
# Ponte Hamlib só do rádio serial (device=radio).
# O -m vem do rádio gravado (radios.json), não de um 3085 fixo.
# Sem device=radio, ou sem modelo, sai 0 e não ocupa a porta da SPE.
# IC-705: rigctld -m <modelo> -r 127.0.0.1:<porta TCP do ser2net> -t 4532
# sem -s e sem -c (o 3085 já usa 0xA4; o baud fica no ser2net, 115200).
# O Hamlib 4.5.5 do apt, ao ver host:port num Icom, abre UDP. O ser2net do
# rádio é TCP cru: o quadro sai e a resposta não volta. O prefixo
# /opt/ham-cockpit/hamlib (4.6+) fala TCP. Binário cuja lib ainda tem
# "Icom rig UDP network enabled" é ignorado.
set -euo pipefail

JSON="${SER2NET_JSON:-/opt/ser2net/services.json}"
LISTEN="${RIGCTLD_LISTEN:-4532}"
HC_HAMLIB="${HC_HAMLIB_PREFIX:-/opt/ham-cockpit/hamlib}"
if [[ -z "${RADIOS_JSON:-}" ]]; then
  if [[ -f /opt/ham-cockpit/radios/radios.json ]]; then
    RADIOS_JSON=/opt/ham-cockpit/radios/radios.json
  elif [[ -f /opt/radios/radios.json ]]; then
    RADIOS_JSON=/opt/radios/radios.json
  else
    RADIOS_JSON=/opt/ham-cockpit/radios/radios.json
  fi
fi

if [[ -d "$HC_HAMLIB/lib" ]]; then
  export LD_LIBRARY_PATH="$HC_HAMLIB/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# 1 quando a lib desse binário ainda força Icom host:port em UDP.
# No prefixo vale o .so ao lado (LD_LIBRARY_PATH / rpath $ORIGIN/../lib).
# ldd sem isso aponta a lib do apt e o 4.6.5 seria descartado à toa.
hamlib_forces_icom_udp() {
  local bin="$1" lib=""
  case "$bin" in
    "$HC_HAMLIB"/bin/*)
      lib="$HC_HAMLIB/lib/libhamlib.so.4"
      ;;
  esac
  if [[ -z "$lib" || ! -r "$lib" ]]; then
    lib=$(ldd "$bin" 2>/dev/null | awk '/libhamlib\.so/{print $3; exit}')
  fi
  [[ -n "$lib" && -r "$lib" ]] && grep -a -q -F 'Icom rig UDP network enabled' "$lib"
}

pick_rigctld() {
  local c
  for c in "$HC_HAMLIB/bin/rigctld" /usr/local/bin/rigctld /usr/bin/rigctld; do
    [[ -x "$c" ]] || continue
    if hamlib_forces_icom_udp "$c"; then
      echo "rigctld-ic705: ignorando $c (Icom em host:port abre UDP; o ser2net do rádio é TCP)" >&2
      continue
    fi
    printf '%s\n' "$c"
    return 0
  done
  return 1
}

if ! RIGCTLD="$(pick_rigctld)"; then
  echo "rigctld-ic705: rigctld não encontrado" >&2
  exit 1
fi

BIND="127.0.0.1"
TCP=""

if [[ -f "$JSON" ]]; then
  read -r BIND TCP < <(python3 - "$JSON" <<'PY'
import json, sys
try:
    raw = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print("NONE", 0)
    raise SystemExit(0)
bind = str(raw.get("bind") or "127.0.0.1").strip() or "127.0.0.1"
tcp = 0
taken = set()
for s in raw.get("services") or []:
    dev = str(s.get("device") or "")
    if dev and dev != "radio":
        try:
            taken.add(int(s.get("tcpPort") or 0))
        except Exception:
            pass
for s in raw.get("services") or []:
    if str(s.get("device") or "") != "radio":
        continue
    try:
        tcp = int(s.get("tcpPort") or 0)
    except Exception:
        tcp = 0
    break
if not tcp or tcp in taken:
    print("NONE", 0)
else:
    print(bind, tcp)
PY
) || true
fi

if [[ "${BIND:-NONE}" == "NONE" || -z "${TCP:-}" || "$TCP" == "0" ]]; then
  echo "rigctld-ic705: sem ser2net device=radio — não ocupa a porta da SPE" >&2
  exit 0
fi

MODEL=""
CIV=""
MODELS_JSON=""
for c in \
  "${HAMLIB_MODELS_JSON:-}" \
  /opt/ham-cockpit/hamlib-models.json \
  "$(dirname "$0")/../hamlib-models.json"
do
  if [[ -n "$c" && -f "$c" ]]; then
    MODELS_JSON="$c"
    break
  fi
done
if [[ -f "$RADIOS_JSON" ]]; then
  read -r MODEL CIV < <(python3 - "$RADIOS_JSON" "$MODELS_JSON" <<'PY'
import json, sys

# deploy/hamlib/models.json — -m e CI-V do Hamlib 4.6.5. Sem chute de token.
# Modelo ausente (IC-7300MK2) não entra e não herda o 3073.
MODELS = {}
path = sys.argv[2] if len(sys.argv) > 2 else ""
if path:
    try:
        MODELS = json.load(open(path, encoding="utf-8")).get("models") or {}
    except Exception:
        MODELS = {}
OFFICIAL = {int(v.get("m") or 0) for v in MODELS.values() if isinstance(v, dict)}
BY_M = {}
for entry in MODELS.values():
    if isinstance(entry, dict) and entry.get("m"):
        BY_M.setdefault(int(entry["m"]), str(entry.get("civ") or ""))

def norm_civ(value):
    text = str(value or "").strip().lower()
    if len(text) == 4 and text.startswith("0x"):
        try:
            int(text[2:], 16)
        except Exception:
            return ""
        return "0x" + text[2:].upper()
    return ""

def resolve(radio):
    if str(radio.get("link") or "") == "network":
        return None
    eid = str(radio.get("equipmentId") or "").strip()
    entry = MODELS.get(eid) if isinstance(MODELS.get(eid), dict) else None
    model = int(entry.get("m") or 0) if entry else 0
    default = str(entry.get("civ") or "") if entry else ""
    if model <= 0:
        try:
            model = int(radio.get("hamlibModel") or 0)
        except Exception:
            model = 0
        if model not in OFFICIAL:
            model = 0
        default = BY_M.get(model, "")
    if model <= 0:
        return None
    civ = ""
    cur = norm_civ(radio.get("civAddr"))
    if str(radio.get("proto") or "") != "cat" and cur and default and cur != default:
        civ = cur
    elif radio.get("hamlibPassCiv") is True and cur and str(radio.get("proto") or "") != "cat":
        civ = cur
    return model, civ

try:
    raw = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print(0, "-")
    raise SystemExit(0)
radios = [r for r in (raw.get("radios") or []) if isinstance(r, dict)]
picked = None
for radio in radios:
    if radio.get("primary") and resolve(radio):
        picked = radio
        break
if picked is None:
    for radio in radios:
        if resolve(radio):
            picked = radio
            break
if picked is None:
    print(0, "-")
else:
    model, civ = resolve(picked)
    print(model, civ or "-")
PY
) || true
fi

BIND="${BIND:-127.0.0.1}"
if [[ -z "${MODEL:-}" || "$MODEL" == "0" ]]; then
  echo "rigctld-ic705: sem modelo Hamlib no rádio serial — não assume -m 3085 nem a porta da SPE" >&2
  exit 0
fi

ARGS=(-m "$MODEL" -r "${BIND}:${TCP}" -t "$LISTEN")
if [[ -n "${CIV:-}" && "$CIV" != "-" ]]; then
  ARGS+=(-c "$CIV")
fi
echo "rigctld-ic705: ${RIGCTLD} ${ARGS[*]}"
exec "$RIGCTLD" "${ARGS[@]}"
