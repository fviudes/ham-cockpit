#!/bin/bash
# Ponte Hamlib só do rádio serial (device=radio).
# O -m vem do rádio gravado (radios.json), não de um 3085 fixo.
# Sem device=radio, ou sem modelo, sai 0 e não ocupa a porta da SPE.
# IC-705 no laboratório: rigctld -m 3085 -r 127.0.0.1:<porta> -t 4532
# sem -s e sem -c (o modelo 3085 já usa 0xA4).
set -euo pipefail

JSON="${SER2NET_JSON:-/opt/ser2net/services.json}"
LISTEN="${RIGCTLD_LISTEN:-4532}"
HC_HAMLIB="${HC_HAMLIB_PREFIX:-/opt/ham-cockpit/hamlib}"
if [[ -z "${RADIOS_JSON:-}" ]]; then
  if [[ -f /opt/ham-cockpit/radios/radios.json ]]; then
    RADIOS_JSON=/opt/ham-cockpit/radios/radios.json
  elif [[ -f /opt/radios/radios.json ]]; then
    RADIOS_JSON=/opt/radios/radios.json
  else
    RADIOS_JSON=/opt/ham-cockpit/radios/radios.json
  fi
fi

if [[ -d "$HC_HAMLIB/lib" ]]; then
  export LD_LIBRARY_PATH="$HC_HAMLIB/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

pick_rigctld() {
  local c
  for c in "$HC_HAMLIB/bin/rigctld" /usr/local/bin/rigctld /usr/bin/rigctld; do
    [[ -x "$c" ]] || continue
    printf '%s\n' "$c"
    return 0
  done
  return 1
}

if ! RIGCTLD="$(pick_rigctld)"; then
  echo "rigctld-ic705: rigctld não encontrado" >&2
  exit 1
fi

BIND="127.0.0.1"
TCP=""

if [[ -f "$JSON" ]]; then
  read -r BIND TCP < <(python3 - "$JSON" <<'PY'
import json, sys
try:
    raw = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print("NONE", 0)
    raise SystemExit(0)
bind = str(raw.get("bind") or "127.0.0.1").strip() or "127.0.0.1"
tcp = 0
taken = set()
for s in raw.get("services") or []:
    dev = str(s.get("device") or "")
    if dev and dev != "radio":
        try:
            taken.add(int(s.get("tcpPort") or 0))
        except Exception:
            pass
for s in raw.get("services") or []:
    if str(s.get("device") or "") != "radio":
        continue
    try:
        tcp = int(s.get("tcpPort") or 0)
    except Exception:
        tcp = 0
    break
if not tcp or tcp in taken:
    print("NONE", 0)
else:
    print(bind, tcp)
PY
) || true
fi

if [[ "${BIND:-NONE}" == "NONE" || -z "${TCP:-}" || "$TCP" == "0" ]]; then
  echo "rigctld-ic705: sem ser2net device=radio — não ocupa a porta da SPE" >&2
  exit 0
fi

MODEL=""
CIV=""
if [[ -f "$RADIOS_JSON" ]]; then
  read -r MODEL CIV < <(python3 - "$RADIOS_JSON" <<'PY'
import json, sys

# Ids já mapeados em shared/equipment/catalog.ts (backend ser2net).
# Não inventar número. Proxy (Hermes/Anan) fica de fora: não é a serial.
KNOWN = {
    "icom-ic-705": 3085,
    "icom-ic-7300": 3073,
    "icom-ic-7300mk2": 3073,
    "icom-ic-7610": 3078,
    "icom-ic-9700": 3081,
    "icom-ic-7100": 3070,
    "kenwood-ts-590sg": 2033,
    "kenwood-ts-890s": 2036,
    "kenwood-ts-990s": 2037,
    "yaesu-ft-991a": 1035,
    "yaesu-ftdx10": 1042,
    "yaesu-ftdx101d": 1041,
    "yaesu-ft-710": 1043,
    "tentec-omniiii": 1601,
    "tentec-eagle": 1608,
    "xiegu-x6100": 3073,
    "xiegu-x6200": 3073,
    "xiegu-g90": 3073,
}
# Token mais longo primeiro. CI-V padrão do -m (só Icom do catálogo).
TOKENS = {
    "icom": (("ic-7300mk2", 3073), ("ic-7300", 3073), ("ic-9700", 3081), ("ic-7610", 3078), ("ic-7100", 3070), ("ic-705", 3085), ("ic705", 3085)),
    "kenwood": (("ts-590", 2033), ("ts-890", 2036), ("ts-990", 2037)),
    "yaesu": (("ftdx101", 1041), ("ftdx10", 1042), ("ft-991", 1035), ("ft-710", 1043)),
    "xiegu": (("x6100", 3073), ("x6200", 3073), ("g90", 3073)),
    "tentec": (("eagle", 1608), ("omni", 1601)),
}
DEFAULT_CIV = {3085: "0xA4", 3073: "0x94", 3070: "0x18", 3078: "0x76", 3081: "0x88"}
CIV_ICOM = {"0xa4": 3085, "0x98": 3085, "0x94": 3073, "0x18": 3070, "0x76": 3078, "0x88": 3081}

def norm_civ(value):
    text = str(value or "").strip().lower()
    if len(text) == 4 and text.startswith("0x"):
        try:
            int(text[2:], 16)
        except Exception:
            return ""
        return "0x" + text[2:].upper()
    return ""

def resolve(radio):
    if str(radio.get("link") or "") == "network":
        return None
    eid = str(radio.get("equipmentId") or "").strip()
    model = 0
    try:
        model = int(radio.get("hamlibModel") or 0)
    except Exception:
        model = 0
    if eid in KNOWN:
        model = KNOWN[eid]
    elif model <= 0:
        blob = " ".join(str(radio.get(k) or "") for k in ("name", "deviceName", "model")).lower()
        maker = str(radio.get("maker") or "")
        for token, num in TOKENS.get(maker, ()):
            if token in blob:
                model = num
                break
        if model <= 0 and maker == "icom" and str(radio.get("proto") or "") != "cat":
            model = CIV_ICOM.get(norm_civ(radio.get("civAddr")), 0)
    if model <= 0:
        return None
    civ = ""
    cur = norm_civ(radio.get("civAddr"))
    if str(radio.get("proto") or "") != "cat":
        if radio.get("hamlibPassCiv") is True and cur:
            civ = cur
        elif radio.get("hamlibPassCiv") is not False:
            default = DEFAULT_CIV.get(model, "")
            if cur and default and cur != default:
                civ = cur
    return model, civ

try:
    raw = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print(0, "-")
    raise SystemExit(0)
radios = [r for r in (raw.get("radios") or []) if isinstance(r, dict)]
picked = None
for radio in radios:
    if radio.get("primary") and resolve(radio):
        picked = radio
        break
if picked is None:
    for radio in radios:
        if resolve(radio):
            picked = radio
            break
if picked is None:
    print(0, "-")
else:
    model, civ = resolve(picked)
    print(model, civ or "-")
PY
) || true
fi

BIND="${BIND:-127.0.0.1}"
if [[ -z "${MODEL:-}" || "$MODEL" == "0" ]]; then
  echo "rigctld-ic705: sem modelo Hamlib no rádio serial — não assume -m 3085 nem a porta da SPE" >&2
  exit 0
fi

ARGS=(-m "$MODEL" -r "${BIND}:${TCP}" -t "$LISTEN")
if [[ -n "${CIV:-}" && "$CIV" != "-" ]]; then
  ARGS+=(-c "$CIV")
fi
echo "rigctld-ic705: ${RIGCTLD} ${ARGS[*]}"
exec "$RIGCTLD" "${ARGS[@]}"
