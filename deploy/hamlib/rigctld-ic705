#!/bin/bash
# Sobe rigctld para o rádio Cat-USB mapeado no ser2net (device=radio).
# Porta TCP/baud vêm de /opt/ser2net/services.json — não do hardcode :4001.
# Clientes (WSJT-X, WaveLogGate, console): modelo 2 em 127.0.0.1:4532.
set -euo pipefail

JSON="${SER2NET_JSON:-/opt/ser2net/services.json}"
LISTEN="${RIGCTLD_LISTEN:-4532}"
MODEL="${RIGCTLD_IC705_MODEL:-3085}"
CIV="${RIGCTLD_IC705_CIV:-0xA4}"
FALLBACK_TCP="${RIGCTLD_FALLBACK_TCP:-4001}"
FALLBACK_BAUD="${RIGCTLD_FALLBACK_BAUD:-115200}"
HC_HAMLIB="${HC_HAMLIB_PREFIX:-/opt/ham-cockpit/hamlib}"

if [[ -d "$HC_HAMLIB/lib" ]]; then
  export LD_LIBRARY_PATH="$HC_HAMLIB/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

pick_rigctld() {
  local c
  for c in "$HC_HAMLIB/bin/rigctld" /usr/local/bin/rigctld /usr/bin/rigctld; do
    [[ -x "$c" ]] || continue
    printf '%s\n' "$c"
    return 0
  done
  return 1
}

if ! RIGCTLD="$(pick_rigctld)"; then
  echo "rigctld-ic705: rigctld não encontrado" >&2
  exit 1
fi

BIND="127.0.0.1"
TCP="$FALLBACK_TCP"
BAUD="$FALLBACK_BAUD"

if [[ -f "$JSON" ]]; then
  read -r BIND TCP BAUD < <(python3 - "$JSON" "$FALLBACK_TCP" "$FALLBACK_BAUD" <<'PY'
import json, sys
p, fb_tcp, fb_baud = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
try:
    raw = json.load(open(p, encoding="utf-8"))
except Exception:
    print("127.0.0.1", fb_tcp, fb_baud)
    raise SystemExit(0)
bind = str(raw.get("bind") or "127.0.0.1").strip() or "127.0.0.1"
tcp, baud = 0, fb_baud
# Preferência: device=radio; senão linha cujo nome parece IC-705 CI-V.
for s in raw.get("services") or []:
    if str(s.get("device") or "") == "radio":
        try:
            tcp = int(s.get("tcpPort") or 0)
        except Exception:
            tcp = 0
        try:
            baud = int(s.get("baud") or fb_baud)
        except Exception:
            baud = fb_baud
        break
if not tcp:
    for s in raw.get("services") or []:
        name = str(s.get("name") or "").lower()
        serial = str(s.get("serial") or "").lower()
        if "ic-705" in name or "ic705" in name or "ci-v" in name or "ttyacm0" in serial or "ic-705" in serial:
            if "gps" in name:
                continue
            try:
                tcp = int(s.get("tcpPort") or 0)
            except Exception:
                tcp = 0
            try:
                baud = int(s.get("baud") or fb_baud)
            except Exception:
                baud = fb_baud
            if tcp:
                break
if not tcp:
    tcp, baud = fb_tcp, fb_baud
print(bind, tcp, baud)
PY
) || true
fi

BIND="${BIND:-127.0.0.1}"
TCP="${TCP:-$FALLBACK_TCP}"
BAUD="${BAUD:-$FALLBACK_BAUD}"
echo "rigctld-ic705: ${RIGCTLD} -m ${MODEL} -r ${BIND}:${TCP} -s ${BAUD} -t ${LISTEN} -c ${CIV}"
exec "$RIGCTLD" -m "$MODEL" -r "${BIND}:${TCP}" -s "$BAUD" -t "$LISTEN" -c "$CIV"
