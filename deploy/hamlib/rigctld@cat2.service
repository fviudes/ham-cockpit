[Unit]
Description=Hamlib rigctld CAT2 via ser2net :4002
After=ser2net.service
Requires=ser2net.service

[Service]
Type=simple
# Ajustar -m ao rádio real (rigctl -l). Porta NET pares: 4534.
ExecStart=/usr/bin/rigctld -m 1021 -r 127.0.0.1:4002 -s 38400 -t 4534
Restart=on-failure
RestartSec=3

[Install]
WantedBy=ham-cockpit.target
