[Unit]
Description=Hamlib ampctld SPE Expert (porta/baud via ser2net device=spe)
After=ser2net.service
Wants=ser2net.service
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# Wrapper lê /opt/ser2net/services.json (device=spe) e usa ampctld ≥4.6 (modelo 401).
ExecStart=/opt/ham-cockpit/bin/ampctld-spe
Restart=on-failure
RestartSec=5

[Install]
WantedBy=ham-cockpit.target
