#!/bin/bash
# BlueZ / RFCOMM do Lextel MS-2000 (SPP Classic).
# O adaptador é compartilhado: Lextel SPP e, no mesmo rádio, o BLE do IC-705
# ou um segundo SPP. Este helper nunca dá rfkill, power off, hciconfig ou
# disconnect fora do MAC pedido — isso derrubaria a outra sessão.
#
# Usage: lextel-bt scan|pair|paired|bind|reconnect|reconnect-saved|release|disconnect|devices|channel <args>
set -euo pipefail

# Sessão própria. O Node mata o grupo do sudo; este processo fica nesse grupo
# e encerra só a sessão nova. systemd-run --pipe não serve: a unit transiente
# sobrevive ao SIGTERM do sudo e empilha bluetoothctl no adaptador compartilhado.
if [[ "${1:-}" != "--in-session" ]]; then
  exec </dev/null
  if command -v setsid >/dev/null 2>&1; then
    out="$(mktemp)"
    err="$(mktemp)"
    setsid "$0" --in-session "$@" </dev/null >"$out" 2>"$err" &
    inner=$!
    cleanup() {
      trap - TERM INT HUP
      kill -TERM -- "-$inner" 2>/dev/null || kill -TERM -- "$inner" 2>/dev/null || true
      wait "$inner" 2>/dev/null || true
      cat "$out" 2>/dev/null || true
      cat "$err" >&2 2>/dev/null || true
      rm -f "$out" "$err"
      exit 143
    }
    trap cleanup TERM INT HUP
    set +e
    wait "$inner"
    rc=$?
    set -e
    trap - TERM INT HUP
    cat "$out" 2>/dev/null || true
    cat "$err" >&2 2>/dev/null || true
    rm -f "$out" "$err"
    exit "$rc"
  fi
  exec "$0" --in-session "$@"
fi
shift
# O rfcomm não pode virar o terminal de controle desta sessão (SIGHUP no console).
exec </dev/null
cd /
trap '' HUP

lockdir=/run/lock
[[ -d "$lockdir" && -w "$lockdir" ]] || lockdir=/tmp
exec 9>"$lockdir/lextel-bt.lock"
if ! flock -n 9; then
  echo "ERR lextel-bt ocupado" >&2
  exit 75
fi

cmd="${1:-}"
mac="$(echo "${2:-}" | tr 'a-f' 'A-F')"
pin="${3:-1234}"
channel="${4:-1}"
rebind="${5:-}"
RFCOMM_DEV="${LEXTEL_RFCOMM:-/dev/rfcomm0}"
RFCOMM_N="${RFCOMM_DEV##*rfcomm}"
[[ "$RFCOMM_N" =~ ^[0-9]+$ ]] || RFCOMM_N=0
NO_CTL="ERR sem controlador Bluetooth (onboard desligado ou dongle USB ausente)"

have_controller() {
  bluetoothctl list 2>/dev/null | grep -q '^Controller '
}

# Liga o rádio só se ele está desligado. power on com o adaptador já no ar
# (e qualquer rfkill / hciconfig) derruba o BLE e o outro SPP.
ensure_adapter() {
  if ! have_controller; then
    echo "$NO_CTL" >&2
    exit 1
  fi
  if bluetoothctl show 2>/dev/null | grep -q 'No default controller'; then
    local pick
    pick="$(bluetoothctl list 2>/dev/null | awk '/^Controller / { print $2; exit }')"
    if [[ -n "${pick:-}" ]]; then
      bluetoothctl select "$pick" >/dev/null 2>&1 || true
    fi
  fi
  if bluetoothctl show 2>/dev/null | grep -q 'Powered: no'; then
    bluetoothctl power on >/dev/null 2>&1 || true
  fi
}

valid_mac() {
  [[ "$mac" =~ ^([0-9A-F]{2}:){5}[0-9A-F]{2}$ ]]
}

rfcomm_line() {
  rfcomm 2>/dev/null | grep -E "^rfcomm${RFCOMM_N}:" || true
}

fix_perms() {
  if [[ -e "$RFCOMM_DEV" ]]; then
    chgrp dialout "$RFCOMM_DEV" 2>/dev/null || true
    chmod 0660 "$RFCOMM_DEV" 2>/dev/null || true
  fi
}

print_devices() {
  local paired_list line addr name paired
  paired_list="$(bluetoothctl devices Paired 2>/dev/null || true)"
  bluetoothctl devices 2>/dev/null | while IFS= read -r line; do
    [[ "$line" == Device* ]] || continue
    addr="$(echo "$line" | awk '{print $2}')"
    name="$(echo "$line" | cut -d' ' -f3-)"
    paired=0
    if echo "$paired_list" | grep -qi "$addr"; then
      paired=1
    fi
    printf 'DEV %s %s %s\n' "$addr" "$paired" "${name:-unknown}"
  done || true
}

rfcomm_state() {
  local line="$1"
  # Palavra inteira: "disconnected" não pode contar como connected.
  if echo "$line" | grep -Eq '[[:space:]]connected([[:space:]]|$)'; then
    echo connected
  elif echo "$line" | grep -Eq '[[:space:]]clean([[:space:]]|$)'; then
    echo clean
  elif echo "$line" | grep -Eq '[[:space:]]config([[:space:]]|$)'; then
    echo config
  elif [[ -z "$line" ]]; then
    echo absent
  else
    echo other
  fi
}

same_binding() {
  local line="$1"
  echo "$line" | grep -qi "$mac" || return 1
  echo "$line" | grep -Eq "channel ${channel}([[:space:]]|$)"
}

# Solta e recria só quando o bind está preso (config) ou o open anterior
# devolveu ENODEV. Espera o nó sumir e o novo aparecer: soltar e abrir no
# mesmo instante deixa /dev/rfcomm0 em ENODEV e o console morre.
settle_bind() {
  local i
  rfcomm release "$RFCOMM_N" 2>/dev/null || true
  for i in $(seq 1 20); do
    [[ -e "$RFCOMM_DEV" ]] || break
    sleep 0.1
  done
  rfcomm bind "$RFCOMM_N" "$mac" "$channel"
  for i in $(seq 1 20); do
    [[ -c "$RFCOMM_DEV" ]] && break
    sleep 0.1
  done
  sleep 0.4
  if [[ ! -c "$RFCOMM_DEV" ]]; then
    echo "ERR $RFCOMM_DEV nao apareceu apos o bind" >&2
    exit 1
  fi
  fix_perms
}

# Alguém ainda está no open(). Soltar o nó nesse instante devolve ENODEV.
rfcomm_held() {
  if command -v fuser >/dev/null 2>&1 && [[ -e "$RFCOMM_DEV" ]]; then
    fuser -s "$RFCOMM_DEV" 2>/dev/null
    return $?
  fi
  return 1
}

# connected e clean do mesmo MAC ficam, inclusive quando o Node pede
# "rebind". clean é o bind pronto para o open, não um link morto: o
# aparelho ainda não atendeu. O console pede rebind depois de um ENODEV
# ou de um open que estourou o prazo. Soltar o clean nesse retry é o que
# derruba o MS-2000 depois da OTA — o open seguinte volta ENODEV e o
# Node fica pedindo rebind para sempre.
# config sem ninguém no fd é DLC preso (o open morreu no meio). Aí sim
# recria. config com o fd aberto é o open em andamento: não solta.
bind_saved() {
  local force="${1:-}"
  local line st
  line="$(rfcomm_line)"
  st="$(rfcomm_state "$line")"
  if same_binding "$line" && [[ "$st" == "connected" || "$st" == "clean" ]]; then
    fix_perms
    echo "OK $RFCOMM_DEV $mac $channel $st"
    return 0
  fi
  if same_binding "$line" && [[ "$st" == "config" ]]; then
    if [[ "$force" != "rebind" ]] || rfcomm_held; then
      fix_perms
      echo "OK $RFCOMM_DEV $mac $channel config"
      return 0
    fi
  fi
  ensure_adapter
  bluetoothctl trust "$mac" >/dev/null 2>&1 || true
  settle_bind
  echo "OK $RFCOMM_DEV $mac $channel"
}

# OTA e install-station. Lê o MAC salvo e não grava o config.json.
reconnect_saved() {
  local spec addr p ch
  [[ -f /opt/lextel/config.json ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  spec="$(python3 - <<'PY'
import json, re
p = "/opt/lextel/config.json"
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    raise SystemExit(0)
if d.get("autoConnect") is False:
    raise SystemExit(0)
addr = str(d.get("addr") or "").strip().upper()
if not re.fullmatch(r"([0-9A-F]{2}:){5}[0-9A-F]{2}", addr):
    raise SystemExit(0)
pin = str(d.get("pin") or "1234")
if not pin.isdigit():
    pin = "1234"
try:
    ch = int(d.get("channel") or 1)
except Exception:
    ch = 1
if ch < 1 or ch > 30:
    ch = 1
print(f"{addr} {pin} {ch}")
PY
)" || true
  [[ -n "$spec" ]] || return 0
  read -r addr p ch <<<"$spec"
  mac="$addr"
  pin="$p"
  channel="$ch"
  valid_mac || return 0
  ensure_adapter
  bluetoothctl trust "$mac" >/dev/null 2>&1 || true
  info="$(bt_info)"
  if ! echo "$info" | grep -q 'Paired: yes'; then
    if ! pair_mac; then
      echo "ERR pair $mac sem vinculo; bind segue" >&2
    fi
  fi
  bind_saved ""
}

bt_info() {
  timeout 4 bluetoothctl info "$mac" 2>/dev/null || true
}

# Não usa coproc: dentro de função o bash fecha o bluetoothctl antes do PIN.
# FIFO no corpo do script. Sem scan se o MAC já está no cache.
pair_mac() {
  local info log fifo pid end
  ensure_adapter
  info="$(bt_info)"
  if echo "$info" | grep -q 'Paired: yes'; then
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true
    echo "OK pair $mac already"
    return 0
  fi
  # "Device MAC not available" ainda começa com Device. Sem isso o scan
  # não roda depois de um remove e o pair falha na hora.
  if ! echo "$info" | grep -q '^Device ' || echo "$info" | grep -qi 'not available'; then
    # scan on também liga LE (0x2005/0x200b) e o mini-UART estoura.
    # bredr acha o MS-2000 sem varrer o BLE do IC-705.
    timeout 8 bluetoothctl --timeout 6 scan bredr >/dev/null 2>&1 || \
      timeout 8 bluetoothctl --timeout 6 scan on >/dev/null 2>&1 || true
    bluetoothctl scan off >/dev/null 2>&1 || true
  fi
  log=/tmp/lextel-pair.log
  : >"$log"
  fifo="$(mktemp -u /tmp/lextel-pair.XXXXXX)"
  mkfifo "$fifo"
  if command -v stdbuf >/dev/null 2>&1; then
    stdbuf -oL -eL bluetoothctl <"$fifo" >"$log" 2>&1 &
  else
    bluetoothctl <"$fifo" >"$log" 2>&1 &
  fi
  pid=$!
  exec 7>"$fifo"
  # bluetoothctl ainda está "Waiting to connect". Comando cedo demais
  # falha com "Failed to register agent object" e o vínculo não nasce.
  end=$((SECONDS + 6))
  while (( SECONDS < end )); do
    if grep -q '\[bluetooth\]' "$log"; then
      break
    fi
    sleep 0.2
  done
  echo "agent off" >&7
  sleep 0.3
  echo "agent KeyboardDisplay" >&7
  sleep 0.4
  echo "default-agent" >&7
  sleep 0.3
  echo "pair $mac" >&7
  end=$((SECONDS + 15))
  while (( SECONDS < end )); do
    if grep -qiE 'PIN code|Request PIN|Enter PIN' "$log" && ! grep -q 'PIN_SENT' "$log"; then
      echo "$pin" >&7 || true
      echo PIN_SENT >>"$log"
    fi
    if grep -qiE 'yes/no|confirm passkey|Request confirmation' "$log" && ! grep -q 'YES_SENT' "$log"; then
      echo "yes" >&7 || true
      echo YES_SENT >>"$log"
    fi
    if grep -qiE 'Pairing successful|Failed to pair|Authentication Failed|AlreadyExists|not available|org.bluez.Error' "$log"; then
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.4
  done
  echo "trust $mac" >&7 || true
  echo "quit" >&7 || true
  exec 7>&-
  wait "$pid" 2>/dev/null || true
  rm -f "$fifo"
  bluetoothctl trust "$mac" >/dev/null 2>&1 || true
  bluetoothctl scan off >/dev/null 2>&1 || true
  if bt_info | grep -q 'Paired: yes'; then
    echo "OK pair $mac"
    return 0
  fi
  echo "ERR pair $mac sem vinculo" >&2
  return 1
}

case "$cmd" in
  scan)
    ensure_adapter
    secs="${2:-12}"
    case "$secs" in
      ''|*[!0-9]*) secs=12 ;;
    esac
    if (( secs < 5 )); then secs=5; fi
    if (( secs > 20 )); then secs=20; fi
    timeout "$secs" bluetoothctl --timeout "$secs" scan on >/dev/null 2>&1 || true
    bluetoothctl scan off >/dev/null 2>&1 || true
    print_devices
    ;;
  devices)
    ensure_adapter
    print_devices
    ;;
  pair)
    valid_mac || { echo "ERR missing MAC" >&2; exit 1; }
    pair_mac
    ;;
  paired)
    valid_mac || { echo "paired=no trusted=no"; exit 0; }
    info="$(bt_info)"
    paired=no
    trusted=no
    if echo "$info" | grep -q 'Paired: yes'; then paired=yes; fi
    if echo "$info" | grep -q 'Trusted: yes'; then trusted=yes; fi
    echo "paired=$paired trusted=$trusted"
    ;;
  channel)
    if ! valid_mac || ! have_controller; then
      echo "${channel:-1}"
      exit 0
    fi
    ch=""
    if command -v sdptool >/dev/null 2>&1; then
      ch="$(timeout 3 sdptool browse "$mac" 2>/dev/null | awk '/Serial Port/{f=1} f && /Channel/{print $2; exit}')" || true
    fi
    echo "${ch:-${channel:-1}}"
    ;;
  bind)
    valid_mac || { echo "ERR missing MAC" >&2; exit 1; }
    case "$channel" in
      ''|*[!0-9]*) channel=1 ;;
    esac
    bind_saved "$rebind"
    ;;
  reconnect)
    # OTA: religa só o MAC pedido. Não grava config, não mexe em ser2net,
    # não dá rfkill, power off nem hciconfig, não solta link connected
    # nem o bind clean (clean não é link morto).
    valid_mac || { echo "ERR missing MAC" >&2; exit 1; }
    case "$channel" in
      ''|*[!0-9]*) channel=1 ;;
    esac
    ensure_adapter
    bluetoothctl trust "$mac" >/dev/null 2>&1 || true
    info="$(bt_info)"
    # Trusted sem Paired deixa o open() em config. Pareia sem scan (MAC já conhecido).
    if ! echo "$info" | grep -q 'Paired: yes'; then
      if ! pair_mac; then
        echo "ERR pair $mac sem vinculo; bind segue" >&2
      fi
    fi
    bind_saved ""
    ;;
  reconnect-saved)
    # MAC de /opt/lextel/config.json. Não reescreve o arquivo.
    reconnect_saved
    ;;
  release)
    rfcomm release "$RFCOMM_N" 2>/dev/null || true
    echo "OK release"
    ;;
  disconnect)
    valid_mac || { echo "ERR missing MAC" >&2; exit 1; }
    rfcomm release "$RFCOMM_N" 2>/dev/null || true
    bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
    echo "OK disconnect $mac"
    ;;
  *)
    echo "ERR usage: lextel-bt scan|devices|pair|paired|channel|bind|reconnect|reconnect-saved|release|disconnect" >&2
    exit 1
    ;;
esac
