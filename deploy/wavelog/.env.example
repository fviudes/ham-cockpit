# Copiar para /opt/wavelog/.env (install-station.sh / install.sh geram a senha se faltar).
# NÃO regenerar a senha se o arquivo já existir — o console lê a mesma chave.
#
# Instalador web Wavelog (http://IP:8086/install):
#   hostname / host = wavelog-db   (rede Docker, não 127.0.0.1)
#   database        = wavelog
#   username        = wavelog
#   password        = WAVELOG_DB_PASSWORD abaixo
#   porta           = 3306 (não publicada no host)
# Boot: sudo bash install.sh  →  systemctl enable --now docker wavelog.service
WAVELOG_DB_PASSWORD=troque-esta-senha
