[Unit]
Description=NextionDriver (ON7LDS) — LCD Nextion no HAT MMDVM / WPSD
Documentation=https://github.com/on7lds/NextionDriver
DefaultDependencies=no
After=local-fs.target network-online.target
Wants=network-online.target
# Sem Before=docker: ham-cockpit.target After=docker.socket + WantedBy=target
# gerava "Transaction order is cyclic" e o daemon Docker nunca subia (lab 11/Nov).
# Sem Before=mmdvmhost: BindsTo/PartOf dos gateways também ciclava.
# LCD no HAT: unit sempre instalada e habilitada (WantedBy ham-cockpit.target).
# ABRT fd2=-1: patch HC_FD2_GUARD no binário, não ordem vs Docker.
ConditionPathExists=/usr/local/bin/NextionDriver

[Service]
Type=simple
User=root
# Cinto de segurança: select()/FD_ISSET do ON7LDS + LimitNOFILE alto do systemd.
# A causa real do ABRT no lab (Port=modem) é FD_SET(fd2) com fd2=-1 (glibc fortify);
# o binário bakeado aplica deploy/mmdvm/patches/nextiondriver-fd2-modem.patch.
LimitNOFILE=1024
ExecStartPre=/bin/mkdir -p /var/log/mmdvm /usr/local/etc
ExecStartPre=-/bin/rm -f /dev/ttyNextionDriver
ExecStart=/bin/bash -c 'INI=/opt/ham-cockpit/mmdvm/mmdvmhost.ini; [[ -f /etc/mmdvmhost ]] && INI=/etc/mmdvmhost; exec /usr/local/bin/NextionDriver -i -c "$INI" -d -v'
# PTY do openpty() nasce 0620 root:tty. hamcockpit está em tty e dialout, mas tty só tem write —
# Host precisa ler+escrever. WPSD evita isso rodando o Host como root.
# Esperar o symlink (users.csv ~4 s) e então dialout+660 (fallback 666).
ExecStartPost=/bin/bash -c 'for i in $(seq 1 40); do t=$(readlink -f /dev/ttyNextionDriver 2>/dev/null || true); if [[ -c "$t" ]]; then chgrp dialout "$t" 2>/dev/null || true; chmod 660 "$t" 2>/dev/null || chmod 666 "$t"; exit 0; fi; sleep 0.25; done; exit 0'
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
KillMode=process
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=ham-cockpit.target
# Só Wants= no mmdvmhost — RequiredBy aqui criava Requires= e ciclo de restart
# com BindsTo dos gateways (Transaction order is cyclic).
