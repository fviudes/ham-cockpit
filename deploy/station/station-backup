#!/bin/bash
# Cópia privilegiada para backup/restore da estação. Chamado via sudo -n.
# Só toca caminhos allowlisted (Wavelog / WaveLogGate / staging em /tmp).
set -euo pipefail

is_safe_rel() {
  local p="$1"
  [[ -n "$p" ]] || return 1
  [[ "$p" != *".."* ]] || return 1
  [[ "$p" != *$'\n'* && "$p" != *$'\r'* ]] || return 1
  return 0
}

allowed_secret() {
  case "$1" in
    /opt/wavelog/.env|/opt/wavelog/docker-compose.yml|/opt/wavelog/wavelog-ctl.sh) return 0 ;;
    /opt/wavelog-gate/wavelog-gate.env) return 0 ;;
    *) return 1 ;;
  esac
}

allowed_staging() {
  case "$1" in
    /tmp/hamcockpit-*|/tmp/restore-hamcockpit-*) return 0 ;;
    *) return 1 ;;
  esac
}

staging_of() {
  local f="$1" cur="$1"
  while [[ "$cur" != "/" && "$cur" != "." ]]; do
    case "$cur" in
      /tmp/hamcockpit-*|/tmp/restore-hamcockpit-*)
        printf '%s\n' "$cur"
        return 0
        ;;
    esac
    cur="$(dirname "$cur")"
  done
  return 1
}

ensure_wavelog_env() {
  local envf="/opt/wavelog/.env"
  [[ -f "$envf" ]] || return 0
  # Serviço hamcockpit precisa ler (backup/dump SQL) e gravar (restore).
  chown hamcockpit:hamcockpit "$envf"
  chmod 640 "$envf"
  # Compose/ctl precisam ser legíveis pelo usuário do console.
  if [[ -f /opt/wavelog/docker-compose.yml ]]; then
    chown root:hamcockpit /opt/wavelog/docker-compose.yml 2>/dev/null || true
    chmod 644 /opt/wavelog/docker-compose.yml 2>/dev/null || true
  fi
  if [[ -f /opt/wavelog/wavelog-ctl.sh ]]; then
    chown root:hamcockpit /opt/wavelog/wavelog-ctl.sh 2>/dev/null || true
    chmod 755 /opt/wavelog/wavelog-ctl.sh 2>/dev/null || true
  fi
  if [[ -f /opt/wavelog-gate/wavelog-gate.env ]]; then
    chown hamcockpit:hamcockpit /opt/wavelog-gate/wavelog-gate.env 2>/dev/null || true
    chmod 640 /opt/wavelog-gate/wavelog-gate.env 2>/dev/null || true
  fi
  echo ok
}

cmd="${1:-}"
case "$cmd" in
  ensure-env)
    ensure_wavelog_env
    ;;
  cat)
    src="${2:-}"
    is_safe_rel "$src" || { echo "caminho inválido" >&2; exit 2; }
    allowed_secret "$src" || { echo "caminho não permitido" >&2; exit 2; }
    [[ -f "$src" ]] || { echo "ausente" >&2; exit 1; }
    cat "$src"
    ;;
  copy)
    # Copia arquivo sensível → staging do backup (root → hamcockpit).
    src="${2:-}"
    dest="${3:-}"
    is_safe_rel "$src" && is_safe_rel "$dest" || { echo "caminho inválido" >&2; exit 2; }
    allowed_secret "$src" || { echo "origem não permitida" >&2; exit 2; }
    stage="$(staging_of "$dest")" || { echo "destino fora do staging" >&2; exit 2; }
    allowed_staging "$stage" || { echo "destino fora do staging" >&2; exit 2; }
    [[ -f "$src" ]] || { echo "ausente" >&2; exit 1; }
    mkdir -p "$(dirname "$dest")"
    cp -a "$src" "$dest"
    chown hamcockpit:hamcockpit "$dest"
    chmod 640 "$dest"
    echo ok
    ;;
  install)
    # Restore: staging → arquivo sensível allowlisted.
    src="${2:-}"
    dest="${3:-}"
    is_safe_rel "$src" && is_safe_rel "$dest" || { echo "caminho inválido" >&2; exit 2; }
    allowed_secret "$dest" || { echo "destino não permitido" >&2; exit 2; }
    stage="$(staging_of "$src")" || { echo "origem fora do staging" >&2; exit 2; }
    allowed_staging "$stage" || { echo "origem fora do staging" >&2; exit 2; }
    [[ -f "$src" ]] || { echo "ausente" >&2; exit 1; }
    mkdir -p "$(dirname "$dest")"
    if [[ "$(basename "$dest")" == ".env" || "$(basename "$dest")" == "wavelog-gate.env" ]]; then
      install -o hamcockpit -g hamcockpit -m 0640 "$src" "$dest"
    elif [[ "$(basename "$dest")" == "wavelog-ctl.sh" ]]; then
      install -o root -g hamcockpit -m 0755 "$src" "$dest"
    else
      install -o root -g hamcockpit -m 0644 "$src" "$dest"
    fi
    echo ok
    ;;
  *)
    echo "uso: station-backup ensure-env|cat PATH|copy SRC DEST|install SRC DEST" >&2
    exit 1
    ;;
esac
