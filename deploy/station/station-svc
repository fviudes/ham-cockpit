#!/bin/bash
# Liga/desliga unidades no boot e start/stop sob demanda. Chamado via sudo -n.
#   station-svc is-active-all            → "id=estado" (um spawn só; usado no polling do console)
#   station-svc list-running             → JSON (systemctl list-units --type=service --state=running)
#   station-svc list-containers          → JSON (docker allowlist)
#   station-svc container-stop|restart|set-limits NAME [MEM_MIB CPUS]
#   station-svc write-wlg-env                → stdin → /opt/wavelog-gate/wavelog-gate.env (não apaga chave)
#   station-svc stop-unit|restart-unit UNIT  → systemctl stop|restart, nome validado (sem path)
#   station-svc enable|disable|start|stop|is-enabled|is-active ID
# IDs com unit própria: ser2net wavelog wlg mmdvm hamlib spe wifi bluetooth web docker
# IDs especiais: db (container wavelog-db), mmdvm (pilha Nextion+Host+gateways via mmdvm-ctl)
# hamlib = rigctld do rádio principal (:4532). SPE fica em ampctld@spe (id spe), separado.
set -euo pipefail

WAVELOG_CTL=/opt/wavelog/wavelog-ctl.sh
MMDVM_CTL=/opt/ham-cockpit/bin/mmdvm-ctl

unit_of() {
  case "${1:-}" in
    ser2net) echo ser2net.service ;;
    wavelog) echo wavelog.service ;;
    wlg) echo waveloggate.service ;;
    mmdvm) echo mmdvmhost.service ;;
    hamlib) echo 'rigctld@ic705.service' ;;
    spe) echo 'ampctld@spe.service' ;;
    wifi) echo ham-cockpit-ap.service ;;
    bluetooth) echo bluetooth.service ;;
    web) echo ham-cockpit.service ;;
    docker) echo docker.service ;;
    db) echo wavelog-db ;; # container, não unit
    *) echo "" ;;
  esac
}

wait_docker_api() {
  local i
  for i in $(seq 1 60); do
    if docker info >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

ensure_docker() {
  systemctl unmask docker.service docker.socket 2>/dev/null || true
  systemctl enable docker.service docker.socket 2>/dev/null || true
  systemctl start docker.socket 2>/dev/null || true
  systemctl start docker.service 2>/dev/null || \
    systemctl start docker.service --job-mode=ignore-dependencies 2>/dev/null || true
  wait_docker_api
}

db_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' wavelog-db 2>/dev/null || true)" == "true" ]]
}

wavelog_main_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' wavelog-main 2>/dev/null || true)" == "true" ]]
}

# start com fallback para ciclo de ordem do systemd ("Transaction order is cyclic").
unit_start() {
  systemctl reset-failed "$1" >/dev/null 2>&1 || true
  systemctl start "$1" || systemctl start --job-mode=ignore-dependencies "$1"
}

cmd="${1:-}"

if [[ "$cmd" == "write-wlg-env" ]]; then
  dest=/opt/wavelog-gate/wavelog-gate.env
  mkdir -p /opt/wavelog-gate
  tmp="$(mktemp)"
  cat >"$tmp"
  grep -qE '^WAVELOG_URL=' "$tmp" || { rm -f "$tmp"; echo "env inválido" >&2; exit 2; }
  # Não apagar chave existente se o POST/stdin veio com WAVELOG_API_KEY vazio.
  python3 - "$tmp" "$dest" <<'PY' || true
import pathlib, re, sys
new_p, old_p = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
text = new_p.read_text(encoding="utf-8", errors="replace")
m = re.search(r"(?m)^WAVELOG_API_KEY=(.*)$", text)
incoming = (m.group(1).strip().strip('"').strip("'") if m else "")
if incoming:
    raise SystemExit(0)
if not old_p.is_file():
    raise SystemExit(0)
old = old_p.read_text(encoding="utf-8", errors="replace")
om = re.search(r"(?m)^WAVELOG_API_KEY=(.*)$", old)
keep = (om.group(1).strip() if om else "")
if not keep:
    raise SystemExit(0)
if m:
    text = re.sub(r"(?m)^WAVELOG_API_KEY=.*$", "WAVELOG_API_KEY=" + keep, text, count=1)
else:
    text = text.rstrip() + "\nWAVELOG_API_KEY=" + keep + "\n"
new_p.write_text(text, encoding="utf-8")
PY
  install -o hamcockpit -g hamcockpit -m 0640 "$tmp" "$dest"
  rm -f "$tmp"
  echo ok
  exit 0
fi

if [[ "$cmd" == "is-active-all" ]]; then
  ids=(ser2net wavelog wlg mmdvm hamlib spe wifi bluetooth web)
  units=()
  for i in "${ids[@]}"; do units+=("$(unit_of "$i")"); done
  mapfile -t st < <(systemctl is-active "${units[@]}" 2>/dev/null || true)
  for i in "${!ids[@]}"; do
    printf '%s=%s\n' "${ids[$i]}" "${st[$i]:-inactive}"
  done
  if command -v docker >/dev/null 2>&1 && db_running; then echo "db=active"; else echo "db=inactive"; fi
  # oneshot wavelog.service fica "active" mesmo com stack parada — o chip segue o container.
  if command -v docker >/dev/null 2>&1 && wavelog_main_running; then echo "wavelog=active"; else echo "wavelog=inactive"; fi
  exit 0
fi

# Unit de serviço: letra/dígito, depois só o alfabeto seguro do systemd. Sem path, sem shell.
valid_service_unit() {
  local u="${1:-}"
  [[ "$u" =~ ^[A-Za-z0-9][A-Za-z0-9:_.@+-]{0,127}\.service$ ]] || return 1
  case "$u" in
    */*|*\\*|*..*) return 1 ;;
    systemd-poweroff.service|systemd-reboot.service|systemd-halt.service|systemd-kexec.service|systemd-soft-reboot.service|poweroff.service|reboot.service|halt.service)
      return 1
      ;;
  esac
  return 0
}

valid_container() {
  case "${1:-}" in
    wavelog-db|wavelog-main) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ "$cmd" == "list-running" ]]; then
  python3 - <<'PY'
import json, os, subprocess, sys
from pathlib import Path

_PS_ENV = {**os.environ, "LC_ALL": "C", "LANG": "C"}


def num(s):
    s = (s or "").strip().replace(",", ".")
    if not s or s in ("-", "[not set]", "infinity", "[unlimited]"):
        return None
    try:
        return float(s)
    except ValueError:
        return None


def show_prop(unit: str, prop: str) -> str:
    try:
        return subprocess.check_output(
            ["systemctl", "show", unit, "-p", prop, "--value"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except subprocess.CalledProcessError:
        return ""


def main_pid(unit: str) -> int:
    for prop in ("MainPID", "ExecMainPID"):
        raw = show_prop(unit, prop)
        try:
            n = int(raw or "0")
        except ValueError:
            n = 0
        if n > 0:
            return n
    return 0


def cgroup_mem(unit: str) -> int | None:
    n = num(show_prop(unit, "MemoryCurrent"))
    return int(n) if n is not None and n >= 0 else None


def cgroup_pids(unit: str) -> list[int]:
    cg = show_prop(unit, "ControlGroup")
    if not cg or cg == "/":
        return []
    base = Path("/sys/fs/cgroup") / cg.lstrip("/")
    procs = base / "cgroup.procs"
    if not procs.is_file():
        return []
    out: list[int] = []
    for line in procs.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            out.append(int(line))
        except ValueError:
            continue
    return out


def unit_pids(unit: str) -> list[int]:
    seen: set[int] = set()
    ordered: list[int] = []
    for pid in (main_pid(unit), *cgroup_pids(unit)):
        if pid > 0 and pid not in seen:
            seen.add(pid)
            ordered.append(pid)
    return ordered


def ps_stats(pids: list[int]) -> tuple[float | None, float | None, int | None]:
    if not pids:
        return None, None, None
    try:
        out = subprocess.check_output(
            ["ps", "-p", ",".join(str(p) for p in pids), "-o", "%cpu=", "%mem=", "rss=", "--no-headers"],
            text=True,
            stderr=subprocess.DEVNULL,
            env=_PS_ENV,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None, None, None
    cpu_sum = 0.0
    mem_sum = 0.0
    rss_sum = 0
    got_cpu = False
    got_mem = False
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        cpu = num(parts[0])
        mem_pct = num(parts[1])
        rss = num(parts[2])
        if cpu is not None:
            cpu_sum += cpu
            got_cpu = True
        if mem_pct is not None:
            mem_sum += mem_pct
            got_mem = True
        if rss is not None:
            rss_sum += int(rss)
    if not got_cpu and not got_mem and rss_sum <= 0:
        return None, None, None
    return (
        round(cpu_sum, 1) if got_cpu else None,
        round(mem_sum, 1) if got_mem else None,
        rss_sum if rss_sum > 0 else None,
    )


raw = subprocess.check_output(
    ["systemctl", "list-units", "--type=service", "--state=running", "--no-pager", "--output=json"],
    text=True,
)
units = json.loads(raw or "[]")
out = []
for row in units:
    if not isinstance(row, dict):
        continue
    unit = str(row.get("unit") or "")
    if not unit:
        continue
    cpu, mem_pct, rss_kb = ps_stats(unit_pids(unit))
    mem_bytes = cgroup_mem(unit)
    if mem_bytes is None and rss_kb is not None:
        mem_bytes = rss_kb * 1024
    item = dict(row)
    if cpu is not None:
        item["cpuPct"] = cpu
    if mem_pct is not None:
        item["memPct"] = mem_pct
    if mem_bytes is not None:
        item["memBytes"] = int(mem_bytes)
    out.append(item)
json.dump(out, sys.stdout)
PY
  exit 0
fi

if [[ "$cmd" == "list-containers" ]]; then
  python3 - <<'PY'
import json, subprocess, sys

ALLOW = ("wavelog-db", "wavelog-main")


def num(s):
    s = (s or "").strip().replace(",", ".")
    if not s or s in ("-", "—"):
        return None
    try:
        return float(s)
    except ValueError:
        return None


def parse_bytes(s):
    s = (s or "").strip().upper()
    if not s or s == "0B":
        return None
    mult = 1
    for suf, m in (("GIB", 1024 ** 3), ("GB", 1000 ** 3), ("MIB", 1024 ** 2), ("MB", 1000 ** 2), ("KIB", 1024), ("KB", 1000)):
        if s.endswith(suf):
            s = s[: -len(suf)].strip()
            mult = m
            break
    if s.endswith("B"):
        s = s[:-1].strip()
    try:
        return int(float(s.replace(",", ".")) * mult)
    except ValueError:
        return None


def inspect_one(name):
    try:
        raw = subprocess.check_output(
            ["docker", "inspect", name],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return None
    if not data or not isinstance(data, list):
        return None
    row = data[0]
    state = ((row.get("State") or {}).get("Status")) or ""
    image = (row.get("Config") or {}).get("Image") or (row.get("Image") or "")
    host = row.get("HostConfig") or {}
    mem_lim = host.get("Memory") or 0
    nano = host.get("NanoCpus") or 0
    cpus = float(nano) / 1e9 if nano and nano > 0 else None
    return {
        "name": name,
        "image": image,
        "state": state,
        "memLimitBytes": int(mem_lim) if mem_lim and mem_lim > 0 else None,
        "cpusLimit": round(cpus, 2) if cpus is not None else None,
        "memUsageBytes": None,
        "cpuPct": None,
    }


def stats_map():
    try:
        out = subprocess.check_output(
            ["docker", "stats", "--no-stream", "--format", "{{json .}}", *ALLOW],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return {}
    m = {}
    for line in out.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        cname = (row.get("Name") or "").lstrip("/")
        if not cname:
            continue
        cpu_raw = (row.get("CPUPerc") or "").replace("%", "").strip()
        mem_raw = (row.get("MemUsage") or "").split("/")[0].strip()
        m[cname] = {
            "cpuPct": num(cpu_raw),
            "memUsageBytes": parse_bytes(mem_raw),
        }
    return m


out = []
sm = stats_map()
for name in ALLOW:
    item = inspect_one(name)
    if item is None:
        item = {
            "name": name,
            "image": "",
            "state": "not-found",
            "memLimitBytes": None,
            "cpusLimit": None,
            "memUsageBytes": None,
            "cpuPct": None,
        }
    st = sm.get(name)
    if st:
        if st.get("cpuPct") is not None:
            item["cpuPct"] = round(st["cpuPct"], 1)
        if st.get("memUsageBytes") is not None:
            item["memUsageBytes"] = st["memUsageBytes"]
    out.append(item)
json.dump(out, sys.stdout)
PY
  exit 0
fi

if [[ "$cmd" == "container-stop" || "$cmd" == "container-restart" || "$cmd" == "container-set-limits" ]]; then
  cname="${2:-}"
  valid_container "$cname" || { echo "contêiner fora da allowlist" >&2; exit 2; }
  if [[ "$cmd" == "container-stop" ]]; then
    docker stop --time=30 "$cname"
    echo stopped
    exit 0
  fi
  if [[ "$cmd" == "container-restart" ]]; then
    docker restart --time=30 "$cname"
    echo restarted
    exit 0
  fi
  mem_mib="${3:-}"
  cpus="${4:-}"
  [[ "$mem_mib" =~ ^[0-9]+$ ]] || { echo "memória inválida" >&2; exit 2; }
  [[ "$mem_mib" -ge 64 && "$mem_mib" -le 4096 ]] || { echo "memória fora da faixa" >&2; exit 2; }
  [[ "$cpus" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "cpus inválidas" >&2; exit 2; }
  python3 - "$cpus" <<'PY'
import sys
cpus = float(sys.argv[1])
if cpus < 0.1 or cpus > 4:
    sys.exit(2)
PY
  mem_bytes=$(( mem_mib * 1024 * 1024 ))
  docker update --memory="$mem_bytes" --cpus="$cpus" "$cname"
  echo updated
  exit 0
fi

if [[ "$cmd" == "stop-unit" || "$cmd" == "restart-unit" ]]; then
  unit="${2:-}"
  valid_service_unit "$unit" || { echo "unit inválida" >&2; exit 2; }
  if [[ "$cmd" == "stop-unit" ]]; then
    systemctl stop -- "$unit"
    echo stopped
  elif [[ "$unit" == "ham-cockpit.service" || "$unit" == "nginx.service" ]]; then
    # --no-block: o systemctl volta antes de o próprio console morrer.
    systemctl restart --no-block -- "$unit"
    echo restarting
  else
    systemctl restart -- "$unit"
    echo restarted
  fi
  exit 0
fi

id="${2:-}"
unit="$(unit_of "$id")"
[[ -n "$unit" ]] || { echo "serviço desconhecido" >&2; exit 2; }

case "$cmd" in
  enable)
    if [[ "$id" == "db" ]]; then
      echo enabled # só a marca do console (boot.json); o container usa restart: unless-stopped
      exit 0
    fi
    systemctl enable "$unit" >/dev/null
    if [[ "$id" == "web" ]]; then
      systemctl enable nginx.service >/dev/null 2>&1 || true
    fi
    if [[ "$id" == "wavelog" || "$id" == "docker" ]]; then
      systemctl enable docker.service docker.socket >/dev/null 2>&1 || true
    fi
    echo enabled
    ;;
  disable)
    if [[ "$id" == "db" ]]; then
      echo disabled
      exit 0
    fi
    if [[ "$id" == "web" ]]; then
      systemctl disable ham-cockpit.service nginx.service >/dev/null 2>&1 || true
    else
      systemctl disable "$unit" >/dev/null
    fi
    echo disabled
    ;;
  start)
    case "$id" in
      wavelog | docker | db)
        ensure_docker || { echo "docker não respondeu" >&2; exit 1; }
        ;;
    esac
    case "$id" in
      docker) ;;
      db)
        if [[ -x "$WAVELOG_CTL" ]]; then
          bash "$WAVELOG_CTL" db-start
        else
          docker start wavelog-db
        fi
        ;;
      mmdvm)
        if [[ -x "$MMDVM_CTL" ]]; then "$MMDVM_CTL" start all >/dev/null; else unit_start "$unit"; fi
        ;;
      *) unit_start "$unit" ;;
    esac
    echo started
    ;;
  stop)
    case "$id" in
      docker)
        echo "recusado: não para o Docker da estação" >&2
        exit 1
        ;;
      db)
        if [[ -x "$WAVELOG_CTL" ]]; then bash "$WAVELOG_CTL" db-stop; else docker stop wavelog-db; fi
        ;;
      mmdvm)
        if [[ -x "$MMDVM_CTL" ]]; then "$MMDVM_CTL" stop all >/dev/null; else systemctl stop "$unit"; fi
        ;;
      *) systemctl stop "$unit" ;;
    esac
    echo stopped
    ;;
  is-enabled)
    if [[ "$id" == "db" ]]; then echo enabled; exit 0; fi
    systemctl is-enabled "$unit" 2>/dev/null || echo disabled
    ;;
  is-active)
    if [[ "$id" == "db" ]]; then
      if db_running; then echo active; else echo inactive; fi
      exit 0
    fi
    systemctl is-active "$unit" 2>/dev/null || echo inactive
    ;;
  *)
    echo "uso: station-svc is-active-all | list-running | list-containers | container-stop|restart|set-limits NAME … | write-wlg-env | stop-unit|restart-unit UNIT | enable|disable|start|stop|is-enabled|is-active ID" >&2
    exit 1
    ;;
esac
