[Unit]
Description=Ham Cockpit VPN de suporte
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/ham-cockpit/support
# run sai 0 se support-vpn.json não estiver enabled; aí o Restart não religa.
ExecStart=/opt/ham-cockpit/bin/station-support-vpn run
Restart=on-failure
RestartSec=5
DeviceAllow=/dev/net/tun rw

[Install]
WantedBy=multi-user.target
