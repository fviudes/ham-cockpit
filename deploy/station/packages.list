# Ham Cockpit OS — Ubuntu Server 24.04 LTS.
# Pacotes da estação; sobem via systemd ham-cockpit.target.

# Rede / primeiro acesso AP + descoberta na LAN
network-manager
iw
rfkill
wireless-regdb
wpasupplicant
hostapd
dnsmasq
iptables
avahi-daemon
libnss-mdns

# Docker (Wavelog PHP + MariaDB)
docker.io
docker-compose-v2

# CAT serial ↔ IP
ser2net
libhamlib-utils

# Bluetooth IC-705 (BlueZ; Web Bluetooth no Chrome)
bluez

# Console web + SSH
nginx
openssh-server
sudo
curl
ca-certificates
openssl
git
usbutils
jq
bsdutils

# Relógio / série
fake-hwclock

# Build MMDVM (g4klx + on7lds) no bake / install-station — toolchain + runtime.
# libwxgtk3.2-dev + libmosquitto-dev: ircddbgatewayd. nlohmann-json3-dev: YSFGateway.
# build-binaries.sh pode purgear os -dev (MMDVM_PURGE_BUILD=1) e reinsere os runtime abaixo.
build-essential
cmake
pkg-config
libusb-1.0-0-dev
libsamplerate0-dev
libmosquitto-dev
nlohmann-json3-dev
libwxgtk3.2-dev
libmosquitto1
mosquitto
# mosquitto (Ubuntu/arm64) liga em libdlt.so.2 — sem isso o broker falha com status 127.
libdlt2
# Runtime ircddbgatewayd: build-binaries PURGE remove -dev; estes ficam (e ota-hooks reinsere se faltar).
libwxbase3.2-1t64
libwxgtk3.2-1t64

# HDMI VFO (tela cheia no monitor do Pi)
cage
seatd
xserver-xorg
xinit
openbox
unclutter
x11-xserver-utils
libgl1-mesa-dri
libgbm1
chromium-browser
firefox
surf
