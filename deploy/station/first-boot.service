[Unit]
Description=Ham Cockpit first boot
After=docker.service docker.socket network-online.target
Wants=docker.service docker.socket network-online.target
ConditionPathExists=!/var/lib/hamcockpit/first-boot-done

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ham-cockpit/bin/first-boot.sh
TimeoutStartSec=0

[Install]
WantedBy=ham-cockpit.target
