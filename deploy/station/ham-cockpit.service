[Unit]
Description=Ham Cockpit web console (:3000, nginx :80)
After=network-online.target
Wants=network-online.target
# Binário ausente (203/EXEC) esgota 5 tentativas e para. Queda isolada volta.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hamcockpit
Group=hamcockpit
# Acesso ao docker.sock para status/backup do Wavelog (grupo docker em /etc/group).
SupplementaryGroups=docker
# /run/ham-cockpit (tmpfs) para veredito license.json — dono = User do serviço.
RuntimeDirectory=ham-cockpit
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/ham-cockpit
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=false
ExecStart=/usr/bin/node /opt/ham-cockpit/index.js
# SIGHUP/SIGINT/SIGTERM/SIGPIPE e exit 0 são saída limpa: on-failure não religa
# (lab 13:46, SIGHUP → success, inactive/dead). always cobre hangup, kill e exit 0.
# Sem SuccessExitStatus — hangup não pode dispensar o restart.
Restart=always
RestartSec=2

[Install]
WantedBy=ham-cockpit.target
