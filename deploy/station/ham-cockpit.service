[Unit]
Description=Ham Cockpit web console (:3000, nginx :80)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hamcockpit
Group=hamcockpit
WorkingDirectory=/opt/ham-cockpit
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/ham-cockpit/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=ham-cockpit.target
