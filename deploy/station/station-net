#!/bin/bash
# Rede da estação: scan, STA, cabo, IPv4, hostname, AP. Chamado via sudo -n.
set -euo pipefail

WLAN="${CATBRIDGE_WLAN:-wlan0}"
AP_CONN="Ham-Cockpit-AP"
NET_CFG="${HC_NET_CONFIG:-/opt/ham-cockpit/net/config.json}"

eth_dev() {
  local d
  for d in eth0 end0 enp1s0 eno1; do
    [[ -d /sys/class/net/$d ]] && { echo "$d"; return 0; }
  done
  return 1
}

wifi_conn() {
  nmcli -t -f NAME,TYPE,DEVICE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless" && $1!="Ham-Cockpit-AP" {print $1; exit}'
}

wired_conn() {
  local eth
  eth="$(eth_dev || true)"
  [[ -n "$eth" ]] || return 1
  nmcli -t -f NAME,DEVICE,TYPE con show --active 2>/dev/null | awk -F: -v e="$eth" '$2==e {print $1; exit}'
}

mask_prefix() {
  python3 - "$1" <<'PY' 2>/dev/null || echo 24
import sys
m = sys.argv[1].split(".")
if len(m) != 4:
    print(24)
    raise SystemExit
n = 0
for p in m:
    b = int(p)
    for _ in range(8):
        if b & 0x80:
            n += 1
            b = (b << 1) & 0xFF
        else:
            print(n)
            raise SystemExit
print(n)
PY
}

valid_host() {
  echo "$1" | grep -Eq '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$'
}

# Pi 4: um rádio. AP 2,4 GHz no wlan0 impede scan/conexão 5 GHz até liberar a interface.
prepare_sta_radio() {
  rfkill unblock wifi 2>/dev/null || true
  rfkill unblock wlan 2>/dev/null || true
  iw reg set BR 2>/dev/null || true
  mkdir -p /etc/wpa_supplicant
  if [[ ! -f /etc/wpa_supplicant/wpa_supplicant.conf ]] || ! grep -q 'country=' /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null; then
    printf 'country=BR\nctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev\nupdate_config=1\n' \
      >/etc/wpa_supplicant/wpa_supplicant.conf
  else
    sed -i 's/^country=.*/country=BR/' /etc/wpa_supplicant/wpa_supplicant.conf 2>/dev/null || true
  fi
  nmcli radio wifi on 2>/dev/null || true
  nmcli device set "$WLAN" managed yes 2>/dev/null || true
  ip link set "$WLAN" up 2>/dev/null || true
}

ap_active_on_wlan() {
  nmcli -t -f NAME,TYPE,DEVICE con show --active 2>/dev/null \
    | awk -F: -v i="$WLAN" -v ap="$AP_CONN" \
      '$2=="802-11-wireless" && ($1==ap || $1=="Hotspot") && $3==i {print $1; exit}'
}

pause_ap_for_sta() {
  local conn
  conn="$(ap_active_on_wlan || true)"
  [[ -n "$conn" ]] || return 0
  nmcli con down "$conn" >/dev/null 2>&1 || true
  nmcli con down Hotspot >/dev/null 2>&1 || true
  nmcli con down "$AP_CONN" >/dev/null 2>&1 || true
  # hostapd fallback (fora do NM) também segura o rádio.
  pkill -f '/etc/ham-cockpit/hostapd-ap.conf' 2>/dev/null || true
  sleep 1
  echo "1"
}

restore_ap_if_idle() {
  local sta
  sta="$(wifi_conn || true)"
  [[ -n "$sta" ]] && return 0
  systemctl start --no-block ham-cockpit-ap.service 2>/dev/null \
    || nmcli -w 20 con up "$AP_CONN" ifname "$WLAN" 2>/dev/null \
    || true
}

# STA em 2,4 GHz bloqueia ver outro SSID 5 GHz no mesmo rádio — desliga só durante o scan.
STA_RESUME_CONN=""

pause_sta_for_scan() {
  STA_RESUME_CONN="$(wifi_conn || true)"
  [[ -n "$STA_RESUME_CONN" ]] || return 0
  nmcli device disconnect "$WLAN" >/dev/null 2>&1 || true
  sleep 1
}

restore_sta_after_scan() {
  local saved="$STA_RESUME_CONN"
  STA_RESUME_CONN=""
  [[ -n "$saved" ]] || return 0
  nmcli -w 30 con up "$saved" ifname "$WLAN" >/dev/null 2>&1 || true
}

wifi_scan_emit() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "$WLAN" <<'PY'
import re
import subprocess
import sys
import time

wlan = sys.argv[1]


def signal_to_pct(sig: int) -> str:
    if sig >= -50:
        return "90"
    if sig >= -60:
        return "75"
    if sig >= -70:
        return "60"
    if sig >= -80:
        return "45"
    if sig >= -90:
        return "30"
    return "20"


def nmcli_rows():
    try:
        out = subprocess.check_output(
            [
                "nmcli",
                "-t",
                "-f",
                "SSID,SIGNAL,SECURITY,CHAN-FREQ",
                "device",
                "wifi",
                "list",
                "ifname",
                wlan,
            ],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        return []
    rows = []
    for line in out.splitlines():
        parts = line.split(":")
        if len(parts) < 2:
            continue
        ssid = parts[0].strip()
        if not ssid or ssid == "--":
            continue
        sig = parts[1].strip() if len(parts) > 1 else "50"
        sec = parts[2].strip() if len(parts) > 2 else ""
        freq = re.sub(r"\D", "", parts[3]) if len(parts) > 3 else ""
        rows.append((ssid, sig, sec, freq))
    return rows


def iw_rows():
    subprocess.run(["iw", "dev", wlan, "scan", "trigger"], capture_output=True)
    time.sleep(6)
    try:
        dump = subprocess.check_output(["iw", "dev", wlan, "scan", "dump"], text=True, stderr=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        return []
    rows = []
    cur_freq = ""
    cur_sig = ""
    for line in dump.splitlines():
        s = line.strip()
        if s.startswith("freq:"):
            cur_freq = re.sub(r"\D", "", s.split(":", 1)[1])
        m = re.search(r"signal:\s*(-?\d+)", s)
        if m:
            cur_sig = m.group(1)
        if "SSID:" in s:
            ssid = s.split("SSID:", 1)[1].strip()
            if not ssid:
                continue
            try:
                dbm = int(cur_sig)
            except ValueError:
                dbm = -75
            rows.append((ssid, signal_to_pct(dbm), "WPA2", cur_freq))
    return rows


def key_of(ssid: str, freq: str) -> str:
    band = ""
    if freq:
        try:
            band = "5" if int(freq) >= 5000 else "24"
        except ValueError:
            band = ""
    return f"{ssid}\0{band}"


best: dict[str, tuple] = {}
for ssid, sig, sec, freq in nmcli_rows() + iw_rows():
    k = key_of(ssid, freq)
    prev = best.get(k)
    try:
        sig_n = int(sig)
    except ValueError:
        sig_n = 50
    if not prev or sig_n > int(prev[1]):
        best[k] = (ssid, str(sig_n), sec, freq)

for ssid, sig, sec, freq in sorted(best.values(), key=lambda t: (-int(t[1]), t[0].lower())):
    print(f"{ssid}\t{sig}\t{sec}\t{freq}")
PY
}

case "${1:-}" in
  scan)
    prepare_sta_radio
    paused_ap="$(pause_ap_for_sta || true)"
    pause_sta_for_scan
    nmcli device wifi rescan ifname "$WLAN" >/dev/null 2>&1 || nmcli device wifi rescan >/dev/null 2>&1 || true
    sleep 3
    if ! wifi_scan_emit; then
      nmcli -t -f SSID,SIGNAL,SECURITY,CHAN-FREQ device wifi list ifname "$WLAN" 2>/dev/null \
        | awk -F: '
          NF >= 2 && $1 != "" && $1 != "--" {
            freq = (NF >= 4 ? $4 : "")
            gsub(/[^0-9]/, "", freq)
            print $1 "\t" $2 "\t" $3 "\t" freq
          }' \
        || nmcli -t -f SSID,SIGNAL,SECURITY device wifi list ifname "$WLAN" 2>/dev/null \
          | awk -F: 'NF>=2 && $1!="" && $1!="--" {print $1 "\t" $2 "\t" $3 "\t"}'
    fi
    restore_sta_after_scan
    if [[ "$paused_ap" == "1" ]]; then
      restore_ap_if_idle
    fi
    ;;
  connect)
    ssid="${2:-}"
    [[ -n "$ssid" ]] || { echo "ssid vazio" >&2; exit 2; }
    pass="$(cat - || true)"
    prepare_sta_radio
    pause_ap_for_sta >/dev/null || true
    # Canais DFS (ex. 153) podem levar ~60s no CAC antes de associar.
    if [[ -z "$pass" ]]; then
      nmcli -w 120 device wifi connect "$ssid" ifname "$WLAN"
    else
      nmcli -w 120 device wifi connect "$ssid" password "$pass" ifname "$WLAN"
    fi
    ;;
  forget)
    ssid="${2:-}"
    [[ -n "$ssid" ]] || exit 2
    nmcli -t -f NAME,TYPE con show | awk -F: -v s="$ssid" '$2=="802-11-wireless" && $1==s {print $1}' | while read -r n; do
      nmcli con delete "$n" >/dev/null 2>&1 || true
    done
    ;;
  link)
    mode="${2:-wifi}"
    eth="$(eth_dev || true)"
    if [[ "$mode" == "ethernet" ]]; then
      [[ -n "$eth" ]] && nmcli device connect "$eth" >/dev/null 2>&1 || true
      sta="$(wifi_conn || true)"
      [[ -n "$sta" ]] && nmcli con down "$sta" >/dev/null 2>&1 || true
    else
      [[ -n "$eth" ]] && nmcli device disconnect "$eth" >/dev/null 2>&1 || true
      sta="$(wifi_conn || true)"
      if [[ -z "$sta" ]]; then
        last="$(nmcli -t -f NAME,TYPE,TIMESTAMP con show | awk -F: '$2=="802-11-wireless" && $1!="Ham-Cockpit-AP" {print $3 "\t" $1}' | sort -nr | head -1 | cut -f2)"
        [[ -n "$last" ]] && nmcli con up "$last" >/dev/null 2>&1 || true
      fi
    fi
    ;;
  ipv4)
    method="${2:-dhcp}"
    conn="${3:-}"
    if [[ -z "$conn" ]]; then
      conn="$(wifi_conn || true)"
      [[ -n "$conn" ]] || conn="$(wired_conn || true)"
    fi
    [[ -n "$conn" ]] || { echo "sem conexão ativa" >&2; exit 2; }
    if [[ "$method" == "dhcp" ]]; then
      nmcli con modify "$conn" ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns "" ipv4.ignore-auto-dns no
    else
      ip="${4:-}"
      mask="${5:-255.255.255.0}"
      gw="${6:-}"
      dns1="${7:-1.1.1.1}"
      dns2="${8:-}"
      pfx="$(mask_prefix "$mask")"
      [[ -n "$ip" ]] || { echo "ip vazio" >&2; exit 2; }
      dns="$dns1"
      [[ -n "$dns2" ]] && dns="$dns1 $dns2"
      nmcli con modify "$conn" \
        ipv4.method manual \
        ipv4.addresses "${ip}/${pfx}" \
        ipv4.gateway "$gw" \
        ipv4.dns "$dns" \
        ipv4.ignore-auto-dns yes
    fi
    nmcli con up "$conn"
    ;;
  hostname)
    name="${2:-}"
    valid_host "$name" || { echo "hostname inválido" >&2; exit 2; }
    hostnamectl set-hostname "$name"
    if grep -qE '^127\.0\.1\.1' /etc/hosts 2>/dev/null; then
      sed -i -E "s/^127\\.0\\.1\\.1.*/127.0.1.1\t${name}/" /etc/hosts
    else
      printf '127.0.1.1\t%s\n' "$name" >>/etc/hosts
    fi
    ;;
  ap)
    ssid="${2:-}"
    psk="$(cat - || true)"
    [[ -n "$ssid" ]] || { echo "ssid vazio" >&2; exit 2; }
    [[ ${#psk} -ge 8 ]] || { echo "senha do AP precisa de 8 caracteres" >&2; exit 2; }
    rfkill unblock wifi 2>/dev/null || true
    iw reg set BR 2>/dev/null || true
    nmcli radio wifi on 2>/dev/null || true
    systemctl stop dnsmasq.service 2>/dev/null || true
    nmcli con delete "$AP_CONN" >/dev/null 2>&1 || true
    nmcli con add type wifi ifname "$WLAN" con-name "$AP_CONN" autoconnect yes ssid "$ssid"
    nmcli con modify "$AP_CONN" \
      802-11-wireless.mode ap \
      802-11-wireless.band bg \
      802-11-wireless.channel 6 \
      wifi-sec.key-mgmt wpa-psk \
      wifi-sec.psk "$psk" \
      ipv4.method shared \
      ipv4.addresses 192.168.4.1/24 \
      ipv6.method disabled \
      connection.autoconnect yes
    nmcli -w 30 con up "$AP_CONN" ifname "$WLAN"
    ;;
  managed)
    nmcli -t -f NAME,TYPE,AUTOCONNECT con show | awk -F: '$2=="802-11-wireless" && $1!="Ham-Cockpit-AP" {print $1 "\t" $3}'
    ;;
  failover)
    [[ -f "$NET_CFG" ]] || { echo "config de rede ausente" >&2; exit 2; }
    prepare_sta_radio
    pause_ap_for_sta >/dev/null || true
    nmcli device wifi rescan ifname "$WLAN" >/dev/null 2>&1 || nmcli device wifi rescan >/dev/null 2>&1 || true
    sleep 2
    mapfile -t _ORDER < <(python3 - "$NET_CFG" <<'PY'
import json, sys
path = sys.argv[1]
try:
    data = json.load(open(path, encoding="utf-8"))
except Exception:
    raise SystemExit
seen = set()
order = []
for entry in data.get("managed") or []:
    if not isinstance(entry, dict):
        continue
    ssid = str(entry.get("ssid") or "").strip()
    if not ssid or ssid in seen:
        continue
    seen.add(ssid)
    order.append(ssid)
sta = str(data.get("staSsid") or "").strip()
sta_psk = str(data.get("staPass") or "").strip()
by_ssid = {
    str(m.get("ssid") or "").strip(): str(m.get("psk") or "").strip()
    for m in (data.get("managed") or [])
    if isinstance(m, dict) and m.get("ssid")
}
if sta and sta not in seen:
    order.insert(0, sta)
    seen.add(sta)
for ssid in order:
    psk = sta_psk if ssid == sta else by_ssid.get(ssid, "")
    print(f"{ssid}\t{psk}")
PY
)
    if [[ "${#_ORDER[@]}" -eq 0 ]]; then
      echo "nenhuma rede salva" >&2
      exit 1
    fi
    _fail_try=0
    for row in "${_ORDER[@]}"; do
      ssid="${row%%$'\t'*}"
      psk="${row#*$'\t'}"
      [[ -n "$ssid" ]] || continue
      _fail_try=1
      if [[ -z "$psk" ]]; then
        if nmcli -w 120 device wifi connect "$ssid" ifname "$WLAN"; then
          exit 0
        fi
      elif nmcli -w 120 device wifi connect "$ssid" password "$psk" ifname "$WLAN"; then
        exit 0
      fi
    done
    [[ "$_fail_try" -eq 1 ]] && exit 1
    exit 2
    ;;
  *)
    echo "uso: station-net scan|connect SSID|forget SSID|link wifi|ethernet|failover|ipv4 ...|hostname NAME|ap SSID|managed" >&2
    exit 1
    ;;
esac
