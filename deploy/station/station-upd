set_env_kv() {
  local f="$1" k="$2" v="$3"
  mkdir -p "$(dirname "$f")"
  touch "$f"
  # .env sem \n final: o append colava a chave na última linha e corrompia WAVELOG_DB_PASSWORD.
  if [[ -s "$f" && -n "$(tail -c1 "$f" 2>/dev/null)" ]]; then printf '\n' >>"$f"; fi
  if grep -q "^${k}=" "$f" 2>/dev/null; then
    sed -i "s|^${k}=.*|${k}=${v}|" "$f"
  else
    printf '%s=%s\n' "$k" "$v" >>"$f"
  fi
}

# Copia o console (dist) + bin/ sem apagar configs da estação
# (layouts, net, services, equipment, radios, ldg, lp100a, mmdvm…).
apply_app() {
  local meta ver file tmp src unit
  emit_progress app 3 prepare 1
  meta="$(github_app_meta)"
  if [[ -z "${meta:-}" ]]; then
    echo "update/version.json ausente em github.com/fviudes/ham-cockpit" >&2
    return 1
  fi
  ver="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' <<<"$meta")"
  file="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("file") or "")' <<<"$meta")"
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN
  if [[ -n "$file" ]]; then
    emit_progress app 8 download 1
    download_with_progress app "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/update/${file}" "$tmp/pkg.tgz" 8 56
    emit_progress app 58 install 1
    run_with_heartbeat app install 58 68 12 tar -xzf "$tmp/pkg.tgz" -C "$tmp"
  else
    echo "canal de update sem arquivo .tgz (version.json.file vazio)" >&2
    return 1
  fi
  src="$(find "$tmp" -maxdepth 4 -type d -name public -printf '%h\n' 2>/dev/null | head -n 1 || true)"
  if [[ -z "${src:-}" ]]; then
    src="$(find "$tmp" -maxdepth 4 -name index.js | head -n 1 || true)"
    [[ -n "${src:-}" ]] && src="$(dirname "$src")"
  fi
  if [[ -z "${src:-}" || ! -f "$src/index.js" || ! -d "$src/public" ]]; then
    echo "pacote de update sem dist/ (index.js + public/)" >&2
    return 1
  fi
  emit_progress app 70 install 1
  mkdir -p "$APP_HOME" "$APP_HOME/bin"
  # Só sobrescreve artefatos do pacote; pastas de config existentes permanecem.
  cp -a "$src/index.js" "$APP_HOME/index.js"
  rm -rf "$APP_HOME/public"
  cp -a "$src/public" "$APP_HOME/public"
  if [[ -f "$src/package.json" ]]; then
    cp -a "$src/package.json" "$APP_HOME/package.json"
  fi
  if [[ -f "$src/ota-hooks.sh" ]]; then
    cp -a "$src/ota-hooks.sh" "$APP_HOME/ota-hooks.sh"
    chmod 0755 "$APP_HOME/ota-hooks.sh"
  fi
  if [[ -f "$src/sudoers-hamcockpit" ]]; then
    cp -a "$src/sudoers-hamcockpit" "$APP_HOME/sudoers-hamcockpit"
  fi
  # versions.json / VERSION só após hooks OK — senão o canal marca sucesso cedo.
  if [[ -f "$src/mmdvm-arm64.tgz" ]]; then
    cp -a "$src/mmdvm-arm64.tgz" "$APP_HOME/mmdvm-arm64.tgz"
  fi
  if [[ -f "$src/hamlib-arm64.tgz" ]]; then
    cp -a "$src/hamlib-arm64.tgz" "$APP_HOME/hamlib-arm64.tgz"
  fi
  if [[ -d "$src/bin" ]]; then
    # Não sobrescreve o station-upd em execução: bash relê o arquivo e pode
    # executar fragmentos (ex. "opt/wavelog-gate") como comando.
    local _f _base _self _dest
    _self="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
    for _f in "$src"/bin/*; do
      [[ -e "$_f" ]] || continue
      _base="$(basename "$_f")"
      if [[ -d "$_f" ]]; then
        mkdir -p "$APP_HOME/bin/$_base"
        cp -a "$_f/." "$APP_HOME/bin/$_base/"
        continue
      fi
      if [[ "$_base" == "station-upd" ]]; then
        _dest="$(readlink -f "$APP_HOME/bin/station-upd" 2>/dev/null || echo "$APP_HOME/bin/station-upd")"
        if [[ "$_self" == "$_dest" ]]; then
          cp -a "$_f" "$APP_HOME/bin/station-upd.ota-next"
          continue
        fi
      fi
      cp -a "$_f" "$APP_HOME/bin/$_base"
    done
    find "$APP_HOME/bin" -maxdepth 1 -type f -exec chmod 0755 {} +
  fi
  if [[ -d "$src/wavelog-gate" ]]; then
    mkdir -p "$APP_HOME/wavelog-gate" /opt/wavelog-gate
    cp -a "$src/wavelog-gate/." "$APP_HOME/wavelog-gate/"
    # Espelha também em /opt/wavelog-gate (ota-hooks pode ter abortado antes).
    cp -a "$src/wavelog-gate/." /opt/wavelog-gate/
    chown -R hamcockpit:hamcockpit /opt/wavelog-gate 2>/dev/null || true
  fi
  if [[ -d "$src/wavelog" ]]; then
    mkdir -p "$APP_HOME/wavelog"
    cp -a "$src/wavelog/." "$APP_HOME/wavelog/"
  fi
  if [[ -d "$src/systemd" ]]; then
    mkdir -p "$APP_HOME/systemd"
    cp -a "$src/systemd/." "$APP_HOME/systemd/"
    for unit in "$src"/systemd/*.service "$src"/systemd/*.target; do
      [[ -f "$unit" ]] || continue
      install -m 0644 "$unit" "/etc/systemd/system/$(basename "$unit")"
    done
    systemctl daemon-reload 2>/dev/null || true
  fi
  emit_progress app 78 install 1
  if [[ -f "$APP_HOME/package.json" ]]; then
    # postinstall chama ota-hooks (|| true no package.json); falha real valida-se abaixo.
    run_with_heartbeat app install 78 86 20 bash -c "cd \"$APP_HOME\" && npm install --omit=dev" || true
  fi
  # Backup do INI do operador ANTES dos hooks. Nunca copiar template por cima.
  # (3× no lab: OTA apagou indicativo/ID na tela; stop Host derruba PartOf.)
  mkdir -p "$APP_HOME/mmdvm"
  if [[ -f "$APP_HOME/mmdvm/mmdvmhost.ini" ]]; then
    cp -a "$APP_HOME/mmdvm/mmdvmhost.ini" "$APP_HOME/mmdvm/mmdvmhost.ini.ota-bak" || true
  fi
  for _ini in dmrgateway.ini ysfgateway.ini ircddbgateway.conf ircddbgateway; do
    if [[ -f "$APP_HOME/mmdvm/$_ini" ]]; then
      cp -a "$APP_HOME/mmdvm/$_ini" "$APP_HOME/mmdvm/${_ini}.ota-bak" || true
    fi
  done
  # Hooks obrigatórios: falha → não bump de VERSION (estação ainda vê OTA no canal).
  if [[ -x "$APP_HOME/ota-hooks.sh" ]]; then
    if ! run_with_heartbeat app install 86 94 25 bash "$APP_HOME/ota-hooks.sh"; then
      echo "ota-hooks.sh falhou — VERSION não avançada (reaplicável)" >&2
      return 1
    fi
  fi
  # Commit atômico da versão só após apply bem-sucedido.
  if [[ -f "$src/versions.json" ]]; then
    cp -a "$src/versions.json" "$APP_HOME/versions.json"
  fi
  if [[ -n "${ver:-}" ]]; then
    printf '%s\n' "$ver" >"$APP_HOME/VERSION"
  elif [[ -f "$src/VERSION" ]]; then
    cp -a "$src/VERSION" "$APP_HOME/VERSION"
  fi
  chown -R hamcockpit:hamcockpit "$APP_HOME" 2>/dev/null || chown -R catbridge:catbridge "$APP_HOME" 2>/dev/null || true
  # Helpers root ficam root:root (sudoers -n).
  if [[ -d "$APP_HOME/bin" ]]; then
    chown root:root "$APP_HOME"/bin/* 2>/dev/null || true
    chmod 0755 "$APP_HOME"/bin/* 2>/dev/null || true
  fi
  # Troca atômica do station-upd só no fim (após hooks).
  if [[ -f "$APP_HOME/bin/station-upd.ota-next" ]]; then
    mv -f "$APP_HOME/bin/station-upd.ota-next" "$APP_HOME/bin/station-upd"
    chown root:root "$APP_HOME/bin/station-upd" 2>/dev/null || true
    chmod 0755 "$APP_HOME/bin/station-upd"
  fi
  emit_progress app 96 restart 1
  NEED_CONSOLE_RESTART=1
  emit_progress app 99 done 1
}

compose_wavelog() {
  local dir="${WAVELOG_DIR:-/opt/wavelog}"
  if docker compose version >/dev/null 2>&1; then
    (cd "$dir" && docker compose "$@")
  elif command -v docker-compose >/dev/null 2>&1; then
    (cd "$dir" && docker-compose "$@")
  else
    echo "docker compose não encontrado" >&2
    return 1
  fi
}

emit_item() {
  local id="$1" current="$2" available="$3" updatable="$4" note="${5:-}"
  printf '{"id":%s,"current":%s,"available":%s,"updatable":%s,"note":%s}' \
    "$(json_escape "$id")" \
    "$(json_escape "$current")" \
    "$(json_escape "$available")" \
    "$updatable" \
    "$(json_escape "$note")"
}

check_os() {
  local cur n note upd="false" avail
  cur="$(os_pretty)"
  n="$(os_upgradable)"
  avail="$cur"
  note=""
  if [[ "${n:-0}" -gt 0 ]]; then
    upd="true"
    avail="$n pacotes"
    note="apt upgrade"
  fi
  emit_item os "$cur" "$avail" "$upd" "$note"
}

check_pkg() {
  local id="$1"
  shift
  local cur cand upd="false"
  cur="$(pkg_installed "$@")"
  if [[ "${UPD_POLICY:-0}" == 1 ]]; then
    cand="$(pkg_candidate "$@")"
  else
    cand=""
  fi
  [[ -z "$cur" ]] && cur="—"
  [[ -z "$cand" ]] && cand="$cur"
  if [[ "$cand" != "$cur" && "$cand" != "—" && "$cur" != "—" ]]; then
    upd="true"
  fi
  emit_item "$id" "$cur" "$cand" "$upd" ""
}

# Preferência: /opt/ham-cockpit/hamlib (tarball SPE 401) sobre apt 4.5.5.
check_hamlib() {
  local cur cand shipped note="" hl=/opt/ham-cockpit/hamlib
  shipped="$(python3 -c 'import json; print(json.load(open("/opt/ham-cockpit/versions.json")).get("hamlib",""))' 2>/dev/null || true)"
  if [[ -x "$hl/bin/ampctl" ]] \
    && LD_LIBRARY_PATH="$hl/lib" "$hl/bin/ampctl" -l 2>/dev/null \
      | awk '$1+0==401 {found=1} END{exit !found}'; then
    cur="$(LD_LIBRARY_PATH="$hl/lib" "$hl/bin/ampctl" -V 2>/dev/null | head -1 | sed -n 's/.*Hamlib \([0-9.]*\).*/\1/p')"
    [[ -z "$cur" ]] && cur="${shipped:-4.6.5}"
    cand="$cur"
    note="prefixo privado (SPE 401)"
    emit_item hamlib "$cur" "$cand" "false" "$note"
    return 0
  fi
  check_pkg hamlib libhamlib-utils hamlib-utils
}

check_wavelog() {
  local cur cand upd="false"
  cur="$(docker_wavelog_ver)"
  [[ -z "$cur" ]] && cur="—"
  cand="$cur"
  emit_item wavelog "$cur" "$cand" "$upd" "docker ghcr.io/wavelog/wavelog"
}

check_wlg() {
  emit_item wlg "$(wlg_ver)" "$(wlg_ver)" "false" ""
}

check_all() {
  local tmp
  tmp="$(mktemp -d)"
  check_app >"$tmp/app" &
  check_os >"$tmp/os" &
  check_pkg ser2net ser2net >"$tmp/ser2net" &
  check_hamlib >"$tmp/hamlib" &
  check_wavelog >"$tmp/wavelog" &
  check_wlg >"$tmp/wlg" &
  wait || true
  printf '{"ok":true,"os":%s,"items":[%s,%s,%s,%s,%s,%s]}\n' \
    "$(json_escape "$(os_pretty)")" \
    "$(cat "$tmp/app")" \
    "$(cat "$tmp/os")" \
    "$(cat "$tmp/ser2net")" \
    "$(cat "$tmp/hamlib")" \
    "$(cat "$tmp/wavelog")" \
    "$(cat "$tmp/wlg")"
  rm -rf "$tmp"
}

# Recupera dpkg/apt interrompidos antes de update/install (Hamlib, OS, rebuild MMDVM).
# Lab: sem isto, `make`/apt falham com dpkg a meio e exit 127 (build-essential ausente).
# Idempotente: em estado limpo, dpkg --configure -a e apt-get -f são no-ops rápidos.
apt_prepare() {
  local id="${1:-os}"
  emit_progress "$id" 4 prepare 1
  export DEBIAN_FRONTEND=noninteractive
  export APT_LISTCHANGES_FRONTEND=none
  # Lab: flash-kernel/dpkg lock deixava apt preso e `make` com exit 127.
  local i
  for i in $(seq 1 25); do
    if command -v fuser >/dev/null 2>&1; then
      if fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
        || fuser /var/lib/dpkg/lock >/dev/null 2>&1 \
        || fuser /var/lib/apt/lists/lock >/dev/null 2>&1; then
        emit_progress "$id" 6 prepare 0
        sleep 1
        continue
      fi
    fi
    break
  done
  if command -v fuser >/dev/null 2>&1; then
    if fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
      || fuser /var/lib/dpkg/lock >/dev/null 2>&1; then
      echo "apt/dpkg ocupado (lock). Tente de novo em instantes." >&2
      return 1
    fi
  fi
  # Evita prompts de conffile que deixariam o dpkg a meio de novo.
  local apt_opts=(
    -o Dpkg::Options::=--force-confdef
    -o Dpkg::Options::=--force-confold
  )
  # stdout silencioso: o Node só parseia o JSON final do station-upd.
  if ! dpkg --configure -a >/dev/null; then
    echo "falha ao concluir configuração pendente do dpkg (dpkg --configure -a)" >&2
    return 1
  fi
  if ! apt-get "${apt_opts[@]}" -y -f install >/dev/null; then
    echo "falha ao corrigir pacotes quebrados (apt-get -f install)" >&2
    return 1
  fi
}

apt_with_progress() {
  local id="$1"
  shift
  set +e
  apt-get -o APT::Status-Fd=3 \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    -y "$@" >/dev/null \
    3> >(python3 -u -c '
import json, sys
uid = sys.argv[1]
for line in sys.stdin:
    parts = line.strip().split(":", 3)
    if len(parts) < 3:
        continue
    kind, frac = parts[0], parts[2]
    try:
        raw = float(frac)
    except ValueError:
        continue
    if raw <= 1.0:
        raw *= 100.0
    pct = int(max(0, min(99, raw)))
    if kind.startswith("dl"):
        stage, mapped = "download", 12 + int(pct * 0.38)
    else:
        stage, mapped = "install", 50 + int(pct * 0.40)
    print("HC_PROGRESS " + json.dumps({"id": uid, "pct": mapped, "stage": stage, "determinate": True}), file=sys.stderr, flush=True)
' "$id")
  local st=$?
  set -e
  return "$st"
}

apply_os() {
  apt_prepare os || return 1
  emit_progress os 10 update 1
  # Antes engolia falha do update com `|| true` → upgrade no-op e toast de sucesso falso.
  if ! run_with_heartbeat os update 10 20 25 timeout 90 apt-get update -qq; then
    echo "falha no apt-get update (sem índices novos o upgrade não aplica nada)" >&2
    return 1
  fi
  emit_progress os 22 install 1
  local pending
  # Mesma política do apply: plain `upgrade` simula 0 Inst com held-back (deps novas).
  pending="$(os_pending_count)"
  pending="${pending:-0}"
  if [[ "$pending" -eq 0 ]]; then
    echo "nenhum pacote pendente no apt; sincronizando contador do console" >&2
    refresh_os_notifier
    emit_progress os 100 done 1
    return 0
  fi
  echo "aplicando $pending pacote(s) via apt-get upgrade --with-new-pkgs" >&2
  # --with-new-pkgs cobre deps novas sem o risco amplo do full-upgrade.
  if ! apt_with_progress os upgrade --with-new-pkgs; then
    echo "falha no apt-get upgrade (veja o journal: journalctl -u ham-cockpit)" >&2
    return 1
  fi
  refresh_os_notifier
  emit_progress os 100 done 1
}

APT_CHANGED=0

apply_pkg() {
  local id="$1"
  shift
  APT_CHANGED=0
  local cur cand
  emit_progress "$id" 5 prepare 1
  cur="$(pkg_installed "$@")"
  cand="$(pkg_candidate "$@")"
  if [[ -n "${cur:-}" && -n "${cand:-}" && "$cur" == "$cand" ]]; then
    echo "pacote já na versão do repositório ($cur); não há o que instalar via apt" >&2
    emit_progress "$id" 100 done 1
    return 0
  fi
  apt_prepare "$id"
  emit_progress "$id" 12 update 0
  run_with_heartbeat "$id" update 10 20 25 timeout 45 apt-get update -qq || true
  cur="$(pkg_installed "$@")"
  cand="$(pkg_candidate "$@")"
  if [[ -n "${cur:-}" && -n "${cand:-}" && "$cur" == "$cand" ]]; then
    echo "pacote já na versão do repositório ($cur); não há o que instalar via apt" >&2
    emit_progress "$id" 100 done 1
    return 0
  fi
  emit_progress "$id" 22 install 1
  local before="$cur"
  apt_with_progress "$id" install "$@"
  cur="$(pkg_installed "$@")"
  if [[ -n "$before" && -n "$cur" && "$cur" != "$before" ]]; then
    APT_CHANGED=1
  fi
  emit_progress "$id" 92 install 1
}

ensure_docker() {
  systemctl unmask docker.service docker.socket 2>/dev/null || true
  systemctl start docker.socket 2>/dev/null || true
  systemctl start docker.service 2>/dev/null || \
    systemctl start docker.service --job-mode=ignore-dependencies 2>/dev/null || true
  local i
  for i in $(seq 1 40); do
    docker info >/dev/null 2>&1 && return 0
    sleep 1
  done
  echo "Docker daemon não está ativo (unix:///var/run/docker.sock)" >&2
  return 1
}

apply_wavelog() {
  local tag image cur
  emit_progress wavelog 4 prepare 1
  tag="$(github_wavelog_tag)"
  if [[ -z "${tag:-}" ]]; then
    echo "não foi possível ler a release do Wavelog no GitHub" >&2
    return 1
  fi
  image="ghcr.io/wavelog/wavelog:${tag}"
  ensure_docker
  emit_progress wavelog 8 download 1
  if ! docker_pull_progress wavelog "$image"; then
    echo "tag ${tag} ausente no GHCR — tentando :latest" >&2
    image="ghcr.io/wavelog/wavelog:latest"
    if ! docker_pull_progress wavelog "$image"; then
      echo "falha ao baixar imagem Docker do Wavelog" >&2
      return 1
    fi
  fi
  emit_progress wavelog 70 install 1
  set_env_kv /opt/wavelog/.env WAVELOG_IMAGE "$image"
  if [[ -f "$APP_HOME/wavelog/docker-compose.yml" ]]; then
    install -o root -g hamcockpit -m 0644 "$APP_HOME/wavelog/docker-compose.yml" /opt/wavelog/docker-compose.yml || true
  fi
  run_with_heartbeat wavelog install 70 88 25 bash -c 'cd /opt/wavelog && docker compose up -d --remove-orphans'
  if [[ -x /opt/wavelog/wavelog-ctl.sh ]]; then
    emit_progress wavelog 90 restart 1
    sed -i 's/\r$//' /opt/wavelog/wavelog-ctl.sh
    /opt/wavelog/wavelog-ctl.sh ensure-db || true
  fi
  cur="$(docker_wavelog_ver)"
  [[ -n "$cur" ]] && printf '%s\n' "$cur" >/opt/wavelog/IMAGE_VERSION
  if [[ -z "$cur" ]]; then
    printf '%s\n' "$tag" >/opt/wavelog/IMAGE_VERSION
    cur="$tag"
  fi
  if app_newer "$tag" "$cur"; then
    echo "Wavelog continua em ${cur} (esperado ${tag})" >&2
    return 1
  fi
  emit_progress wavelog 100 done 1
}

apply_wlg() {
  local remote tmp cur
  emit_progress wlg 4 prepare 1
  remote="$(curl -fsSL --max-time 12 -A "Ham-Cockpit/0.1.06" \
    "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/deploy/wavelog-gate/VERSION" | tr -d '[:space:]' || true)"
  if [[ -z "${remote:-}" ]]; then
    echo "não foi possível ler deploy/wavelog-gate/VERSION no GitHub" >&2
    return 1
  fi
  tmp="$(mktemp)"
  emit_progress wlg 10 download 1
  if ! download_with_progress wlg \
    "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/deploy/wavelog-gate/wavelog-gate.mjs" \
    "$tmp" 10 70; then
    rm -f "$tmp"
    echo "falha ao baixar wavelog-gate.mjs" >&2
    return 1
  fi
  mkdir -p /opt/wavelog-gate
  install -o hamcockpit -g hamcockpit -m 0755 "$tmp" /opt/wavelog-gate/wavelog-gate.mjs
  rm -f "$tmp"
  printf '%s\n' "$remote" >/opt/wavelog-gate/VERSION
  chown hamcockpit:hamcockpit /opt/wavelog-gate/wavelog-gate.mjs /opt/wavelog-gate/VERSION 2>/dev/null || true
  mkdir -p "$APP_HOME/wavelog-gate"
  cp -a /opt/wavelog-gate/wavelog-gate.mjs "$APP_HOME/wavelog-gate/wavelog-gate.mjs" 2>/dev/null || true
  cp -a /opt/wavelog-gate/VERSION "$APP_HOME/wavelog-gate/VERSION" 2>/dev/null || true
  emit_progress wlg 82 restart 1
  systemctl restart waveloggate.service 2>/dev/null || true
  cur="$(wlg_ver)"
  if [[ "$cur" != "$remote" ]]; then
    echo "WaveLogGate continua em ${cur} (esperado ${remote})" >&2
    return 1
  fi
  emit_progress wlg 100 done 1
}

cmd="${1:-}"
id="${2:-}"

case "$cmd" in
  check)
    check_all
    ;;
  refresh)
    # Sem apt_prepare (espera de lock). Índices com teto curto; policy só no refresh.
    timeout 25 apt-get update -qq || true
    UPD_POLICY=1 check_all
    ;;
  apply)
    case "$id" in
      app) apply_app ;;
      os) apply_os ;;
      ser2net)
        apply_pkg ser2net ser2net
        if [[ "${APT_CHANGED:-0}" == 1 ]]; then
          emit_progress ser2net 94 restart 1
          systemctl restart ser2net.service 2>/dev/null || true
        fi
        emit_progress ser2net 100 done 1
        ;;
      hamlib)
        # SPE Expert (401) exige Hamlib ≥4.6 — tarball OTA em /usr/local; apt Noble fica em 4.5.5.
        if [[ -f "$APP_HOME/hamlib-arm64.tgz" ]]; then
          emit_progress hamlib 40 install 1
          tmp_hl="$(mktemp -d)"
          if tar -xzf "$APP_HOME/hamlib-arm64.tgz" -C "$tmp_hl" \
            && [[ -d "$tmp_hl/bin" ]]; then
            mkdir -p /opt/ham-cockpit/hamlib/bin /opt/ham-cockpit/hamlib/lib
            find "$tmp_hl/bin" -maxdepth 1 -type f -exec install -m 0755 {} /opt/ham-cockpit/hamlib/bin/ \;
            [[ -d "$tmp_hl/lib" ]] && cp -a "$tmp_hl/lib"/. /opt/ham-cockpit/hamlib/lib/
            find /opt/ham-cockpit/hamlib/lib -name '*.la' -delete 2>/dev/null || true
          fi
          rm -rf "$tmp_hl"
          emit_progress hamlib 94 restart 1
          systemctl restart 'ampctld@*' 2>/dev/null || true
        else
          apply_pkg hamlib libhamlib-utils hamlib-utils >/dev/null || apply_pkg hamlib libhamlib-utils >/dev/null || apply_pkg hamlib hamlib-utils >/dev/null
          if [[ "${APT_CHANGED:-0}" == 1 ]]; then
            emit_progress hamlib 94 restart 1
            systemctl restart 'rigctld@*' 2>/dev/null || true
            systemctl restart 'ampctld@*' 2>/dev/null || true
          fi
        fi
        emit_progress hamlib 100 done 1
        ;;
      wavelog)
        apply_wavelog
        ;;
      wlg)
        apply_wlg
        ;;
      *)
        echo '{"ok":false,"error":"componente desconhecido"}' >&2
        exit 2
        ;;
    esac
    check_all
    if [[ "${NEED_CONSOLE_RESTART:-0}" == 1 ]]; then
      schedule_console_restart
    fi
    ;;
  *)
    echo "uso: station-upd check|refresh|apply ID" >&2
    exit 1
    ;;
esac
