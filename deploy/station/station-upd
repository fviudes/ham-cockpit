#!/bin/bash
# Consulta e aplica atualizações no Ubuntu Server. Chamado via sudo -n.
set -euo pipefail

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

# stderr: HC_PROGRESS {"id","pct","stage","determinate"}
emit_progress() {
  local id="$1" pct="$2" stage="$3" det="${4:-1}"
  python3 -c 'import json,sys
print("HC_PROGRESS "+json.dumps({"id":sys.argv[1],"pct":int(float(sys.argv[2])),"stage":sys.argv[3],"determinate":sys.argv[4]=="1"}), flush=True)' \
    "$id" "$pct" "$stage" "$det" >&2
}

pkg_installed() {
  local n
  for n in "$@"; do
    if dpkg-query -W -f='${Status}' "$n" 2>/dev/null | grep -q "install ok installed"; then
      dpkg-query -W -f='${Version}' "$n" 2>/dev/null
      return 0
    fi
  done
  echo ""
}

pkg_candidate() {
  local n cand
  for n in "$@"; do
    cand="$(timeout 4 apt-cache policy "$n" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')" || true
    if [[ -n "${cand:-}" && "$cand" != "(none)" ]]; then
      echo "$cand"
      return 0
    fi
  done
  echo ""
}

os_pretty() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "${PRETTY_NAME:-Ubuntu Server}"
  else
    echo "Ubuntu Server"
  fi
}

os_upgradable() {
  # apt list --upgradable no Pi 3 leva dezenas de segundos. Arquivo do motd é instantâneo.
  local n=""
  if [[ -f /var/lib/update-notifier/updates-available ]]; then
    n="$(grep -Eo '^[0-9]+' /var/lib/update-notifier/updates-available 2>/dev/null | head -n 1 || true)"
  fi
  if [[ -z "${n:-}" && -x /usr/lib/update-notifier/apt-check ]]; then
    n="$(timeout 2 /usr/lib/update-notifier/apt-check 2>&1 | awk -F';' '{print $1+0}')" || true
  fi
  echo "${n:-0}"
}

docker_wavelog_ver() {
  local v
  v="$(timeout 2 docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}} {{.Config.Image}}' wavelog-main 2>/dev/null || true)"
  v="$(awk '{print ($1!="" && $1!="<no" && $1!="<no value>") ? $1 : $2}' <<<"$v")"
  [[ "$v" == "<no" || "$v" == "<no value>" ]] && v=""
  echo "${v:-}"
}

wlg_ver() {
  if [[ -f /opt/wavelog-gate/VERSION ]]; then
    tr -d '[:space:]' </opt/wavelog-gate/VERSION
  else
    echo "1.0.0"
  fi
}

APP_HOME="/opt/ham-cockpit"
if [[ ! -d "$APP_HOME" && -d /opt/cat-bridge ]]; then
  APP_HOME="/opt/cat-bridge"
fi

app_ver() {
  if [[ -f "$APP_HOME/VERSION" ]]; then
    tr -d '[:space:]' <"$APP_HOME/VERSION"
  else
    echo "0.1.03"
  fi
}

github_app_meta() {
  curl -fsSL --max-time 8 -A "Ham-Cockpit/0.1.04.01" "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/update/version.json" || true
}

# 0.1.05 < 0.1.05.01 < 0.1.06 (partes ausentes = 0).
app_newer() {
  python3 -c '
import re, sys
def parts(v):
    n = [int(x) for x in re.findall(r"\d+", (v or "").lstrip("vV"))]
    n += [0] * 4
    return n[:4]
sys.exit(0 if parts(sys.argv[1]) > parts(sys.argv[2]) else 1)
' "$1" "$2"
}

# Check local rápido: o Node sobrepõe a versão publicada do app (GitHub).
check_app() {
  local cur
  cur="$(app_ver)"
  emit_item app "$cur" "$cur" "false" "github.com/fviudes/ham-cockpit/update"
}

download_with_progress() {
  local id="$1" url="$2" dest="$3"
  python3 - "$id" "$url" "$dest" <<'PY'
import json, sys, urllib.request
uid, url, dest = sys.argv[1], sys.argv[2], sys.argv[3]
def hook(block, size, total):
    got = block * size
    if total and total > 0:
        pct = max(8, min(55, int(got * 50 / total) + 8))
        print("HC_PROGRESS " + json.dumps({"id": uid, "pct": pct, "stage": "download", "determinate": True}), file=sys.stderr, flush=True)
    else:
        print("HC_PROGRESS " + json.dumps({"id": uid, "pct": 15, "stage": "download", "determinate": False}), file=sys.stderr, flush=True)
req = urllib.request.Request(url, headers={"User-Agent": "Ham-Cockpit/0.1.05"})
with urllib.request.urlopen(req, timeout=90) as r, open(dest, "wb") as out:
    total = int(r.headers.get("Content-Length") or 0)
    n = 0
    bs = 64 * 1024
    while True:
        chunk = r.read(bs)
        if not chunk:
            break
        out.write(chunk)
        n += len(chunk)
        hook(n, 1, total)
PY
}

# Copia o console (dist) + bin/ sem apagar configs da estação
# (layouts, net, services, equipment, radios, ldg, lp100a, mmdvm…).
apply_app() {
  local meta ver file tmp src unit
  emit_progress app 5 prepare 1
  meta="$(github_app_meta)"
  if [[ -z "${meta:-}" ]]; then
    echo "update/version.json ausente em github.com/fviudes/ham-cockpit" >&2
    return 1
  fi
  ver="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' <<<"$meta")"
  file="$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("file") or "")' <<<"$meta")"
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN
  if [[ -n "$file" ]]; then
    emit_progress app 8 download 1
    download_with_progress app "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/update/${file}" "$tmp/pkg.tgz"
    emit_progress app 58 install 1
    tar -xzf "$tmp/pkg.tgz" -C "$tmp"
  else
    echo "canal de update sem arquivo .tgz (version.json.file vazio)" >&2
    return 1
  fi
  src="$(find "$tmp" -maxdepth 4 -type d -name public -printf '%h\n' 2>/dev/null | head -n 1 || true)"
  if [[ -z "${src:-}" ]]; then
    src="$(find "$tmp" -maxdepth 4 -name index.js | head -n 1 || true)"
    [[ -n "${src:-}" ]] && src="$(dirname "$src")"
  fi
  if [[ -z "${src:-}" || ! -f "$src/index.js" || ! -d "$src/public" ]]; then
    echo "pacote de update sem dist/ (index.js + public/)" >&2
    return 1
  fi
  emit_progress app 70 install 1
  mkdir -p "$APP_HOME" "$APP_HOME/bin"
  # Só sobrescreve artefatos do pacote; pastas de config existentes permanecem.
  cp -a "$src/index.js" "$APP_HOME/index.js"
  rm -rf "$APP_HOME/public"
  cp -a "$src/public" "$APP_HOME/public"
  if [[ -f "$src/package.json" ]]; then
    cp -a "$src/package.json" "$APP_HOME/package.json"
  fi
  if [[ -f "$src/ota-hooks.sh" ]]; then
    cp -a "$src/ota-hooks.sh" "$APP_HOME/ota-hooks.sh"
    chmod 0755 "$APP_HOME/ota-hooks.sh"
  fi
  if [[ -f "$src/sudoers-hamcockpit" ]]; then
    cp -a "$src/sudoers-hamcockpit" "$APP_HOME/sudoers-hamcockpit"
  fi
  if [[ -f "$src/versions.json" ]]; then
    cp -a "$src/versions.json" "$APP_HOME/versions.json"
  fi
  if [[ -f "$src/mmdvm-arm64.tgz" ]]; then
    cp -a "$src/mmdvm-arm64.tgz" "$APP_HOME/mmdvm-arm64.tgz"
  fi
  if [[ -d "$src/bin" ]]; then
    cp -a "$src/bin/." "$APP_HOME/bin/"
    find "$APP_HOME/bin" -maxdepth 1 -type f -exec chmod 0755 {} +
  fi
  if [[ -d "$src/wavelog-gate" ]]; then
    mkdir -p "$APP_HOME/wavelog-gate" /opt/wavelog-gate
    cp -a "$src/wavelog-gate/." "$APP_HOME/wavelog-gate/"
  fi
  if [[ -d "$src/systemd" ]]; then
    mkdir -p "$APP_HOME/systemd"
    cp -a "$src/systemd/." "$APP_HOME/systemd/"
    for unit in "$src"/systemd/*.service "$src"/systemd/*.target; do
      [[ -f "$unit" ]] || continue
      install -m 0644 "$unit" "/etc/systemd/system/$(basename "$unit")"
    done
    systemctl daemon-reload 2>/dev/null || true
  fi
  if [[ -n "${ver:-}" ]]; then
    printf '%s\n' "$ver" >"$APP_HOME/VERSION"
  elif [[ -f "$src/VERSION" ]]; then
    cp -a "$src/VERSION" "$APP_HOME/VERSION"
  fi
  emit_progress app 82 install 1
  if [[ -f "$APP_HOME/package.json" ]]; then
    (cd "$APP_HOME" && npm install --omit=dev) || true
  fi
  # Backup do INI do operador ANTES dos hooks. Nunca copiar template por cima.
  # (3× no lab: OTA apagou indicativo/ID na tela; stop Host derruba PartOf.)
  mkdir -p "$APP_HOME/mmdvm"
  if [[ -f "$APP_HOME/mmdvm/mmdvmhost.ini" ]]; then
    cp -a "$APP_HOME/mmdvm/mmdvmhost.ini" "$APP_HOME/mmdvm/mmdvmhost.ini.ota-bak" || true
  fi
  for _ini in dmrgateway.ini ysfgateway.ini ircddbgateway.conf ircddbgateway; do
    if [[ -f "$APP_HOME/mmdvm/$_ini" ]]; then
      cp -a "$APP_HOME/mmdvm/$_ini" "$APP_HOME/mmdvm/${_ini}.ota-bak" || true
    fi
  done
  # Garante units/bin mesmo se o postinstall do npm não rodou.
  if [[ -x "$APP_HOME/ota-hooks.sh" ]]; then
    bash "$APP_HOME/ota-hooks.sh" || true
  fi
  chown -R hamcockpit:hamcockpit "$APP_HOME" 2>/dev/null || chown -R catbridge:catbridge "$APP_HOME" 2>/dev/null || true
  # Helpers root ficam root:root (sudoers -n).
  if [[ -d "$APP_HOME/bin" ]]; then
    chown root:root "$APP_HOME"/bin/* 2>/dev/null || true
    chmod 0755 "$APP_HOME"/bin/* 2>/dev/null || true
  fi
  emit_progress app 92 restart 1
  systemctl restart ham-cockpit.service 2>/dev/null || systemctl restart cat-bridge.service 2>/dev/null || true
  systemctl try-restart ham-cockpit-ap.service 2>/dev/null || true
  emit_progress app 100 done 1
}

compose_wavelog() {
  local dir="${WAVELOG_DIR:-/opt/wavelog}"
  if docker compose version >/dev/null 2>&1; then
    (cd "$dir" && docker compose "$@")
  elif command -v docker-compose >/dev/null 2>&1; then
    (cd "$dir" && docker-compose "$@")
  else
    echo "docker compose não encontrado" >&2
    return 1
  fi
}

emit_item() {
  local id="$1" current="$2" available="$3" updatable="$4" note="${5:-}"
  printf '{"id":%s,"current":%s,"available":%s,"updatable":%s,"note":%s}' \
    "$(json_escape "$id")" \
    "$(json_escape "$current")" \
    "$(json_escape "$available")" \
    "$updatable" \
    "$(json_escape "$note")"
}

check_os() {
  local cur n note upd="false" avail
  cur="$(os_pretty)"
  n="$(os_upgradable)"
  avail="$cur"
  note=""
  if [[ "${n:-0}" -gt 0 ]]; then
    upd="true"
    avail="$n pacotes"
    note="apt upgrade"
  fi
  emit_item os "$cur" "$avail" "$upd" "$note"
}

check_pkg() {
  local id="$1"
  shift
  local cur cand upd="false"
  cur="$(pkg_installed "$@")"
  if [[ "${UPD_POLICY:-0}" == 1 ]]; then
    cand="$(pkg_candidate "$@")"
  else
    cand=""
  fi
  [[ -z "$cur" ]] && cur="—"
  [[ -z "$cand" ]] && cand="$cur"
  if [[ "$cand" != "$cur" && "$cand" != "—" && "$cur" != "—" ]]; then
    upd="true"
  fi
  emit_item "$id" "$cur" "$cand" "$upd" ""
}

check_wavelog() {
  local cur cand upd="false"
  cur="$(docker_wavelog_ver)"
  [[ -z "$cur" ]] && cur="—"
  cand="$cur"
  emit_item wavelog "$cur" "$cand" "$upd" "docker ghcr.io/wavelog/wavelog"
}

check_wlg() {
  emit_item wlg "$(wlg_ver)" "$(wlg_ver)" "false" ""
}

check_all() {
  local tmp
  tmp="$(mktemp -d)"
  check_app >"$tmp/app" &
  check_os >"$tmp/os" &
  check_pkg ser2net ser2net >"$tmp/ser2net" &
  check_pkg hamlib libhamlib-utils hamlib-utils >"$tmp/hamlib" &
  check_wavelog >"$tmp/wavelog" &
  check_wlg >"$tmp/wlg" &
  wait || true
  printf '{"ok":true,"os":%s,"items":[%s,%s,%s,%s,%s,%s]}\n' \
    "$(json_escape "$(os_pretty)")" \
    "$(cat "$tmp/app")" \
    "$(cat "$tmp/os")" \
    "$(cat "$tmp/ser2net")" \
    "$(cat "$tmp/hamlib")" \
    "$(cat "$tmp/wavelog")" \
    "$(cat "$tmp/wlg")"
  rm -rf "$tmp"
}

# Recupera dpkg/apt interrompidos antes de update/install (Hamlib, OS, rebuild MMDVM).
# Lab: sem isto, `make`/apt falham com dpkg a meio e exit 127 (build-essential ausente).
# Idempotente: em estado limpo, dpkg --configure -a e apt-get -f são no-ops rápidos.
apt_prepare() {
  local id="${1:-os}"
  emit_progress "$id" 4 prepare 1
  export DEBIAN_FRONTEND=noninteractive
  export APT_LISTCHANGES_FRONTEND=none
  # Lab: flash-kernel/dpkg lock deixava apt preso e `make` com exit 127.
  local i
  for i in $(seq 1 25); do
    if command -v fuser >/dev/null 2>&1; then
      if fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
        || fuser /var/lib/dpkg/lock >/dev/null 2>&1 \
        || fuser /var/lib/apt/lists/lock >/dev/null 2>&1; then
        emit_progress "$id" 6 prepare 0
        sleep 1
        continue
      fi
    fi
    break
  done
  if command -v fuser >/dev/null 2>&1; then
    if fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
      || fuser /var/lib/dpkg/lock >/dev/null 2>&1; then
      echo "apt/dpkg ocupado (lock). Tente de novo em instantes." >&2
      return 1
    fi
  fi
  # Evita prompts de conffile que deixariam o dpkg a meio de novo.
  local apt_opts=(
    -o Dpkg::Options::=--force-confdef
    -o Dpkg::Options::=--force-confold
  )
  if ! dpkg --configure -a; then
    echo "falha ao concluir configuração pendente do dpkg (dpkg --configure -a)" >&2
    return 1
  fi
  if ! apt-get "${apt_opts[@]}" -y -f install; then
    echo "falha ao corrigir pacotes quebrados (apt-get -f install)" >&2
    return 1
  fi
}

apt_with_progress() {
  local id="$1"
  shift
  set +e
  apt-get -o APT::Status-Fd=3 \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    -y "$@" >/dev/null \
    3> >(python3 -u -c '
import json, sys
uid = sys.argv[1]
for line in sys.stdin:
    parts = line.strip().split(":", 3)
    if len(parts) < 3:
        continue
    kind, frac = parts[0], parts[2]
    try:
        raw = float(frac)
    except ValueError:
        continue
    if raw <= 1.0:
        raw *= 100.0
    pct = int(max(0, min(99, raw)))
    if kind.startswith("dl"):
        stage, mapped = "download", 12 + int(pct * 0.38)
    else:
        stage, mapped = "install", 50 + int(pct * 0.40)
    print("HC_PROGRESS " + json.dumps({"id": uid, "pct": mapped, "stage": stage, "determinate": True}), file=sys.stderr, flush=True)
' "$id")
  local st=$?
  set -e
  return "$st"
}

apply_os() {
  apt_prepare os
  emit_progress os 12 update 0
  timeout 45 apt-get update -qq >/dev/null || true
  emit_progress os 22 install 1
  if ! apt_with_progress os upgrade >/dev/null; then
    echo "falha no apt-get upgrade (veja o journal: journalctl -u ham-cockpit)" >&2
    return 1
  fi
  emit_progress os 100 done 1
}

APT_CHANGED=0

apply_pkg() {
  local id="$1"
  shift
  APT_CHANGED=0
  local cur cand
  emit_progress "$id" 5 prepare 1
  cur="$(pkg_installed "$@")"
  cand="$(pkg_candidate "$@")"
  if [[ -n "${cur:-}" && -n "${cand:-}" && "$cur" == "$cand" ]]; then
    echo "pacote já na versão do repositório ($cur); não há o que instalar via apt" >&2
    emit_progress "$id" 100 done 1
    return 0
  fi
  apt_prepare "$id"
  emit_progress "$id" 12 update 0
  timeout 45 apt-get update -qq >/dev/null || true
  cur="$(pkg_installed "$@")"
  cand="$(pkg_candidate "$@")"
  if [[ -n "${cur:-}" && -n "${cand:-}" && "$cur" == "$cand" ]]; then
    echo "pacote já na versão do repositório ($cur); não há o que instalar via apt" >&2
    emit_progress "$id" 100 done 1
    return 0
  fi
  emit_progress "$id" 22 install 1
  local before="$cur"
  apt_with_progress "$id" install "$@"
  cur="$(pkg_installed "$@")"
  if [[ -n "$before" && -n "$cur" && "$cur" != "$before" ]]; then
    APT_CHANGED=1
  fi
  emit_progress "$id" 92 install 1
}

ensure_docker() {
  systemctl unmask docker.service docker.socket 2>/dev/null || true
  systemctl start docker.socket 2>/dev/null || true
  systemctl start docker.service 2>/dev/null || \
    systemctl start docker.service --job-mode=ignore-dependencies 2>/dev/null || true
  local i
  for i in $(seq 1 40); do
    docker info >/dev/null 2>&1 && return 0
    sleep 1
  done
  echo "Docker daemon não está ativo (unix:///var/run/docker.sock)" >&2
  return 1
}

apply_wavelog() {
  emit_progress wavelog 4 prepare 1
  ensure_docker
  emit_progress wavelog 8 download 0
  compose_wavelog pull
  emit_progress wavelog 70 install 1
  compose_wavelog up -d --remove-orphans
  if [[ -x /opt/wavelog/wavelog-ctl.sh ]]; then
    emit_progress wavelog 88 restart 1
    sed -i 's/\r$//' /opt/wavelog/wavelog-ctl.sh
    /opt/wavelog/wavelog-ctl.sh ensure-db || true
  fi
  emit_progress wavelog 100 done 1
}

cmd="${1:-}"
id="${2:-}"

case "$cmd" in
  check)
    check_all
    ;;
  refresh)
    # Sem apt_prepare (espera de lock). Índices com teto curto; policy só no refresh.
    timeout 25 apt-get update -qq || true
    UPD_POLICY=1 check_all
    ;;
  apply)
    case "$id" in
      app) apply_app ;;
      os) apply_os ;;
      ser2net)
        apply_pkg ser2net ser2net
        if [[ "${APT_CHANGED:-0}" == 1 ]]; then
          emit_progress ser2net 94 restart 1
          systemctl restart ser2net.service 2>/dev/null || true
        fi
        emit_progress ser2net 100 done 1
        ;;
      hamlib)
        apply_pkg hamlib libhamlib-utils hamlib-utils >/dev/null || apply_pkg hamlib libhamlib-utils >/dev/null || apply_pkg hamlib hamlib-utils >/dev/null
        if [[ "${APT_CHANGED:-0}" == 1 ]]; then
          emit_progress hamlib 94 restart 1
          systemctl restart 'rigctld@*' 2>/dev/null || true
          systemctl restart 'ampctld@*' 2>/dev/null || true
        fi
        emit_progress hamlib 100 done 1
        ;;
      wavelog)
        apply_wavelog
        ;;
      wlg)
        emit_progress wlg 20 download 0
        mkdir -p /opt/wavelog-gate
        if [[ -f "$APP_HOME/wavelog-gate/wavelog-gate.mjs" ]]; then
          install -o hamcockpit -g hamcockpit -m 0755 "$APP_HOME/wavelog-gate/wavelog-gate.mjs" /opt/wavelog-gate/wavelog-gate.mjs
        else
          curl -fsSL --max-time 20 -A "Ham-Cockpit" \
            "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/deploy/wavelog-gate/wavelog-gate.mjs" \
            -o /opt/wavelog-gate/wavelog-gate.mjs || true
          chmod 0755 /opt/wavelog-gate/wavelog-gate.mjs 2>/dev/null || true
        fi
        if [[ -f "$APP_HOME/wavelog-gate/VERSION" ]]; then
          install -o hamcockpit -g hamcockpit -m 0644 "$APP_HOME/wavelog-gate/VERSION" /opt/wavelog-gate/VERSION
        else
          curl -fsSL --max-time 12 -A "Ham-Cockpit" \
            "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/deploy/wavelog-gate/VERSION" \
            -o /opt/wavelog-gate/VERSION || true
        fi
        chown hamcockpit:hamcockpit /opt/wavelog-gate/wavelog-gate.mjs /opt/wavelog-gate/VERSION 2>/dev/null || true
        emit_progress wlg 80 restart 1
        systemctl restart waveloggate.service 2>/dev/null || true
        emit_progress wlg 100 done 1
        ;;
      *)
        echo '{"ok":false,"error":"componente desconhecido"}' >&2
        exit 2
        ;;
    esac
    check_all
    ;;
  *)
    echo "uso: station-upd check|refresh|apply ID" >&2
    exit 1
    ;;
esac
