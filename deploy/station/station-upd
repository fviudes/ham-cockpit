#!/bin/bash
# Consulta e aplica atualizações no Ubuntu Server. Chamado via sudo -n.
set -euo pipefail

json_escape() {
  python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"
}

# stderr: HC_PROGRESS {"id","pct","stage","determinate"}
emit_progress() {
  local id="$1" pct="$2" stage="$3" det="${4:-1}"
  python3 -c 'import json,sys
print("HC_PROGRESS "+json.dumps({"id":sys.argv[1],"pct":int(float(sys.argv[2])),"stage":sys.argv[3],"determinate":sys.argv[4]=="1"}), flush=True)' \
    "$id" "$pct" "$stage" "$det" >&2
}

pkg_installed() {
  local n
  for n in "$@"; do
    if dpkg-query -W -f='${Status}' "$n" 2>/dev/null | grep -q "install ok installed"; then
      dpkg-query -W -f='${Version}' "$n" 2>/dev/null
      return 0
    fi
  done
  echo ""
}

pkg_candidate() {
  local n cand
  for n in "$@"; do
    cand="$(timeout 4 apt-cache policy "$n" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')" || true
    if [[ -n "${cand:-}" && "$cand" != "(none)" ]]; then
      echo "$cand"
      return 0
    fi
  done
  echo ""
}

os_pretty() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    echo "${PRETTY_NAME:-Ubuntu Server}"
  else
    echo "Ubuntu Server"
  fi
}

# Conta pacotes que o apply_os realmente instala (upgrade --with-new-pkgs).
# `apt-get -s upgrade` puro dá 0 Inst quando há held-back por deps novas — falso "já atualizado".
os_pending_count() {
  local n
  n="$(timeout 25 apt-get -s -o Debug::NoLocking=1 upgrade --with-new-pkgs 2>/dev/null | grep -c '^Inst ' || true)"
  echo "${n:-0}"
}

os_upgradable() {
  # Contagem rápida: motd/notifier. No refresh (UPD_POLICY=1) força apt-check / simulação real.
  local n=""
  if [[ "${UPD_POLICY:-0}" == 1 ]]; then
    if [[ -x /usr/lib/update-notifier/apt-check ]]; then
      n="$(timeout 8 /usr/lib/update-notifier/apt-check 2>&1 | awk -F';' '{print $1+0}')" || true
    fi
    if [[ -z "${n:-}" || "${n:-0}" -eq 0 ]]; then
      n="$(os_pending_count)"
    fi
    echo "${n:-0}"
    return 0
  fi
  if [[ -f /var/lib/update-notifier/updates-available ]]; then
    n="$(grep -Eo '^[0-9]+' /var/lib/update-notifier/updates-available 2>/dev/null | head -n 1 || true)"
  fi
  if [[ -z "${n:-}" && -x /usr/lib/update-notifier/apt-check ]]; then
    n="$(timeout 2 /usr/lib/update-notifier/apt-check 2>&1 | awk -F';' '{print $1+0}')" || true
  fi
  echo "${n:-0}"
}

# Regrava o contador do motd para o card OS não ficar "pendente" eterno após o apply.
refresh_os_notifier() {
  local n=0
  n="$(os_pending_count)"
  if [[ -x /usr/lib/update-notifier/apt-check ]]; then
    # apt-check pode ficar stale; se a simulação real diz 0, zera o motd.
    local chk
    chk="$(timeout 8 /usr/lib/update-notifier/apt-check 2>&1 | awk -F';' '{print $1+0}')" || chk="$n"
    if [[ "${n:-0}" -eq 0 ]]; then
      n=0
    elif [[ "${chk:-0}" -gt 0 ]]; then
      n="$chk"
    fi
  fi
  n="${n:-0}"
  mkdir -p /var/lib/update-notifier
  printf '%s updates can be applied immediately.\n' "$n" >/var/lib/update-notifier/updates-available
}

docker_wavelog_ver() {
  local v img
  v="$(timeout 2 docker inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' wavelog-main 2>/dev/null || true)"
  v="$(tr -d '[:space:]' <<<"${v:-}")"
  if [[ -z "$v" || "$v" == "<no" || "$v" == "<no"* ]]; then
    if [[ -f /opt/wavelog/IMAGE_VERSION ]]; then
      v="$(tr -d '[:space:]' </opt/wavelog/IMAGE_VERSION)"
    fi
  fi
  if [[ -z "$v" ]]; then
    img="$(timeout 2 docker inspect --format '{{.Config.Image}}' wavelog-main 2>/dev/null || true)"
    v="${img##*:}"
    [[ "$v" == "$img" || "$v" == "latest" ]] && v=""
  fi
  echo "${v:-}"
}

wlg_ver() {
  if [[ -f /opt/wavelog-gate/VERSION ]]; then
    tr -d '[:space:]' </opt/wavelog-gate/VERSION
  else
    echo "1.0.0"
  fi
}

APP_HOME="/opt/ham-cockpit"
if [[ ! -d "$APP_HOME" && -d /opt/cat-bridge ]]; then
  APP_HOME="/opt/cat-bridge"
fi
NEED_CONSOLE_RESTART=0

app_ver() {
  if [[ -f "$APP_HOME/VERSION" ]]; then
    tr -d '[:space:]' <"$APP_HOME/VERSION"
  else
    echo "0.1.03"
  fi
}

github_app_meta() {
  curl -fsSL --max-time 8 -A "Ham-Cockpit/0.1.04.01" "https://raw.githubusercontent.com/fviudes/ham-cockpit/main/update/version.json" || true
}

# 0.1.05 < 0.1.05.01 < 0.1.06 (partes ausentes = 0).
app_newer() {
  python3 -c '
import re, sys
def parts(v):
    n = [int(x) for x in re.findall(r"\d+", (v or "").lstrip("vV"))]
    n += [0] * 4
    return n[:4]
sys.exit(0 if parts(sys.argv[1]) > parts(sys.argv[2]) else 1)
' "$1" "$2"
}

# Check local rápido: o Node sobrepõe a versão publicada do app (GitHub).
check_app() {
  local cur
  cur="$(app_ver)"
  emit_item app "$cur" "$cur" "false" "github.com/fviudes/ham-cockpit/update"
}

# Heartbeat enquanto um comando longo roda (prepare/install/restart sem byte count).
run_with_heartbeat() {
  local id="$1" stage="$2" lo="$3" hi="$4" eta="$5"
  shift 5
  python3 - "$id" "$stage" "$lo" "$hi" "$eta" "$@" <<'PY'
import json, subprocess, sys, threading, time
uid, stage, lo, hi, eta = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4]), float(sys.argv[5] or 8)
cmd = sys.argv[6:]
stop = False
t0 = time.time()

def emit(pct):
    elapsed = time.time() - t0
    remain = max(0, int(eta - elapsed))
    print(
        "HC_PROGRESS "
        + json.dumps({"id": uid, "pct": int(pct), "stage": stage, "determinate": True, "etaSec": remain}),
        file=sys.stderr,
        flush=True,
    )

def beat():
    while not stop:
        elapsed = time.time() - t0
        frac = 1 - pow(2, -elapsed / max(eta, 1.5))
        emit(lo + (hi - lo) * min(0.97, frac))
        time.sleep(0.35)

th = threading.Thread(target=beat, daemon=True)
th.start()
try:
    rc = subprocess.call(cmd)
finally:
    stop = True
sys.exit(rc)
PY
}

download_with_progress() {
  local id="$1" url="$2" dest="$3" lo="${4:-8}" hi="${5:-55}"
  python3 - "$id" "$url" "$dest" "$lo" "$hi" <<'PY'
import json, sys, time, urllib.request
uid, url, dest = sys.argv[1], sys.argv[2], sys.argv[3]
lo, hi = int(sys.argv[4]), int(sys.argv[5])
req = urllib.request.Request(url, headers={"User-Agent": "Ham-Cockpit/0.1.06"})
t0 = time.time()
last = 0.0
with urllib.request.urlopen(req, timeout=120) as r, open(dest, "wb") as out:
    total = int(r.headers.get("Content-Length") or 0)
    n = 0
    bs = 64 * 1024
    while True:
        chunk = r.read(bs)
        if not chunk:
            break
        out.write(chunk)
        n += len(chunk)
        now = time.time()
        if now - last < 0.2 and (total <= 0 or n < total):
            continue
        last = now
        elapsed = max(now - t0, 0.001)
        rate = n / elapsed
        if total > 0:
            frac = min(1.0, n / total)
            eta = int((total - n) / rate) if rate > 0 else 0
        else:
            # Sem Content-Length: sobe em curva até hi, ETA pela taxa recente.
            frac = min(0.97, 1 - pow(2, -n / (12 * 1024 * 1024)))
            eta = int(max(8, (12 * 1024 * 1024 - n) / rate)) if rate > 0 else 20
        pct = int(lo + (hi - lo) * frac)
        print(
            "HC_PROGRESS "
            + json.dumps({
                "id": uid,
                "pct": pct,
                "stage": "download",
                "determinate": True,
                "bytes": n,
                "totalBytes": total,
                "etaSec": max(0, eta),
            }),
            file=sys.stderr,
            flush=True,
        )
PY
}

docker_pull_progress() {
  local id="$1" image="$2"
  python3 - "$id" "$image" <<'PY'
import json, re, subprocess, sys, threading, time
uid, image = sys.argv[1], sys.argv[2]
t0 = time.time()
stop = False
got = tot = 0
units = {"B": 1, "kB": 1000, "KB": 1000, "MB": 1_000_000, "GB": 1_000_000_000}

def emit(pct, eta, stage="download"):
    print(
        "HC_PROGRESS "
        + json.dumps({
            "id": uid,
            "pct": int(max(8, min(68, pct))),
            "stage": stage,
            "determinate": True,
            "bytes": int(got),
            "totalBytes": int(tot),
            "etaSec": int(max(0, eta)),
        }),
        file=sys.stderr,
        flush=True,
    )

def beat():
    while not stop:
        elapsed = time.time() - t0
        frac = 1 - pow(2, -elapsed / 40.0)
        emit(8 + 58 * min(0.96, frac), max(5, 45 - elapsed), "download")
        time.sleep(0.4)

th = threading.Thread(target=beat, daemon=True)
th.start()
p = subprocess.Popen(
    ["docker", "pull", image],
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True,
    bufsize=1,
)
assert p.stdout is not None
for line in p.stdout:
    m = re.search(
        r"(\d+(?:\.\d+)?)\s*(B|kB|KB|MB|GB)\s*/\s*(\d+(?:\.\d+)?)\s*(B|kB|KB|MB|GB)",
        line,
        re.I,
    )
    if not m:
        continue
    got = float(m.group(1)) * units.get(m.group(2), 1)
    tot = float(m.group(3)) * units.get(m.group(4), 1)
    elapsed = max(time.time() - t0, 0.001)
    eta = ((tot - got) / (got / elapsed)) if got > 0 and tot > got else 0
    frac = (got / tot) if tot else 0
    emit(8 + 60 * min(1.0, frac), eta)
rc = p.wait()
stop = True
sys.exit(rc)
PY
}

schedule_console_restart() {
  # Fora do cgroup do console — senão o apply morre com código nulo.
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --quiet --collect --no-block \
      /bin/bash -c 'sleep 3; systemctl try-restart ham-cockpit.service >/dev/null 2>&1 || true' \
      >/dev/null 2>&1 || true
    return 0
  fi
  nohup bash -c 'sleep 3; systemctl try-restart ham-cockpit.service >/dev/null 2>&1 || true' >/dev/null 2>&1 &
}

